@inherits LayoutComponentBase
@inject ServerOptions Settings
<header>
    <a class="brand" href="./">@Settings.DisplayName <span>SP Backup · мониторинг</span></a>
    <div class="header-actions">
    <button type="button" class="quiet theme-toggle" data-theme-toggle hidden>Тёмная тема</button>
    <AuthorizeView>
        <Authorized><nav><a href="problems">Проблемы</a><a href="./">Агенты</a><a href="connect">Подключить агент</a><a href="settings">Настройки</a>
            <form action="session/logout" method="post"><AntiforgeryToken /><button class="quiet" type="submit">Выйти</button></form></nav></Authorized>
    </AuthorizeView>
    </div>
</header>
<main>@Body</main>
<footer>Связь с агентом и результат резервного копирования — отдельные состояния. Время показано в поясе: @Clock.ZoneLabel. Смещение относительно UTC указано рядом с датой.
    @if (Clock.LoadWarning) { <p class="error">Настройку часового пояса прочитать не удалось. Временно используется UTC; сохраните нужный пояс в настройках сервера.</p> }
    <small>Сборка: @Build</small></footer>
@code {
    private static string Build => typeof(ServerHost).Assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
        .Cast<System.Reflection.AssemblyInformationalVersionAttribute>().FirstOrDefault()?.InformationalVersion ?? "unknown";
}
