@page "/agents/{Id:guid}/jobs/new"
@page "/agents/{Id:guid}/jobs/{JobId:guid}/edit"
@page "/agents/{Id:guid}/jobs/{TemplateId:guid}/copy"
@attribute [Authorize(Policy = ServerAuthentication.Administrator)]
@inject ServerStore Store
@inject IHttpContextAccessor Http
@inject ServerOptions Settings
<PageTitle>Мастер задания — @Settings.DisplayName</PageTitle>
<a href="@($"agents/{Id}/jobs")">← Задания агента</a>
<h1>@(TemplateId is not null ? "Новое задание на основе существующего" : JobId is null ? "Новое задание" : "Изменить задание")</h1>
@if (Saved is { } saved)
{
    <section class="card narrow" role="status"><h2>Задание сохранено</h2>
        <p>Новая ревизия: <strong>@saved.Revision</strong>. Ожидается получение и проверка настроек агентом.</p>
        <p>Это ещё не результат копирования. Проверьте принятие ревизии и следующий запуск в карточке агента.</p>
        <div class="actions"><a class="button" href="@($"agents/{Id}")">Карточка агента</a><a href="@($"agents/{Id}/jobs")">Все задания</a></div>
    </section>
}
else if (Model is { } model && Configuration is not null && Agent is { Revoked: false })
{
    <p>Компьютер: <strong>@Agent.Name</strong>. Настройки будут применены после получения агентом новой ревизии.</p>
    @if (TemplateId is not null)
    { <p>Это отдельное новое задание. Проверьте источник и папки копий. Расписание копии сначала выключено: при необходимости включите его на следующем шаге. Исходное задание не изменится.</p> }
    <ol class="wizard-steps" aria-label="Шаги мастера">
        @foreach (var step in Steps.Select((label, index) => (label, number: index + 1)))
        { <li class="@(model.Step == step.number ? "current" : "")" aria-current="@(model.Step == step.number ? "step" : null)">@step.number. @step.label</li> }
    </ol>
    <section class="card narrow">
        @if (Error is not null) { <p class="error" role="alert">@Error</p> }
        @if (Errors.Count > 0) { <div class="error" role="alert"><ul>@foreach (var error in Errors) { <li>@error</li> }</ul></div> }
        @if (Conflict) { <p>Ваши значения остались в форме. Откройте актуальный список в другой вкладке и сравните изменения. Автоматической перезаписи нет.</p><a href="@($"agents/{Id}/jobs")" target="_blank" rel="noopener">Открыть актуальный список</a> }
        <form method="post" @formname="job-wizard" @onsubmit="Submit">
            <AntiforgeryToken />
            @if (!Conflict && model.Step < 4)
            { <button type="submit" name="Command" value="next" class="wizard-default-submit" tabindex="-1" aria-hidden="true">Далее</button> }
            @foreach (var field in model.HiddenFields()) { <input type="hidden" name="@field.Key" value="@field.Value" /> }
            @if (model.Step == 1)
            {
                <h2>1. Что копировать</h2>
                <label>Название задания<input name="Model.Name" value="@model.Name" maxlength="256" placeholder="Можно оставить пустым — по названию источника" /></label>
                <p>Если название пустое, на следующем шаге появится имя папки или файла. Для 1С с файлом 1Cv8.1CD используется имя папки базы.
                    Автоматическое название меняется вместе с источником. Введите своё название, чтобы сохранить его; очистите поле, чтобы снова использовать автоматическое.</p>
                <label>Тип источника<select name="Model.Kind">
                    <option value="FilesAndFolders" selected="@(model.Kind == "FilesAndFolders")">Файлы и папки</option>
                    <option value="OneCFile" selected="@(model.Kind == "OneCFile")">Файловая база 1С — архив ZIP</option>
                </select></label>
                <label>Полный путь к источнику<input name="Model.Source" value="@model.Source" maxlength="4096" required placeholder="C:\Данные или \\сервер\папка" spellcheck="false" /></label>
                <p>Укажите путь <strong>на компьютере агента</strong>. Проводник на сервере не показывает диски другого компьютера.
                    Для 1С укажите папку файловой базы или её файл 1Cv8.1CD. Серверные базы 1С и SQL в этом мастере пока не поддерживаются.</p>
                <label class="check"><input type="checkbox" name="Model.AllowOpen" value="true" checked="@model.AllowOpen" />Для файловой 1С: разрешить архивирование открытой базы</label>
                <input type="hidden" name="Model.AllowOpen" value="false" />
                <p>Лучше закрыть 1С перед копированием. Разрешение действует только для файловой базы; предупреждение появится, если она действительно была открыта.</p>
            }
            else if (model.Step == 2)
            {
                <h2>2. Когда делать копии</h2>
                <label>Расписание<select name="Model.Schedule">
                    @foreach (var schedule in new[] { "Manual", "Daily", "Weekly", "SystemStartup" })
                    { <option value="@schedule" selected="@(model.Schedule == schedule)">@FileJobDraft.ScheduleLabel(schedule)</option> }
                </select></label>
                <label class="check"><input type="checkbox" name="Model.Enabled" value="true" checked="@model.Enabled" />Включить расписание задания</label><input type="hidden" name="Model.Enabled" value="false" />
                <p>Ручной запуск в Windows-программе остаётся доступен и при выключенном расписании. Для автоматических копий агент или его служба должны работать.</p>
                <label>Время для ежедневного или недельного расписания<input name="Model.Times" value="@model.Times" maxlength="600" placeholder="23:00 или 09:00, 23:00" /></label>
                <label>Часовой пояс<select name="Model.TimeZone">
                    <option value="Local" selected="@(model.TimeZone == "Local")">Время компьютера агента</option>
                    @foreach (var zone in Zones(model.TimeZone)) { <option value="@zone.Key" selected="@(model.TimeZone == zone.Key)">@zone.Value</option> }
                </select></label>
                <fieldset><legend>Дни для недельного расписания</legend><div class="weekdays">
                    @foreach (var day in FileJobDraft.Days)
                    { <label class="check"><input type="checkbox" name="@("Model." + day.Key)" value="true" checked="@model.DayValue(day.Key)" />@day.Label</label><input type="hidden" name="@("Model." + day.Key)" value="false" /> }
                </div></fieldset>
                <p>При выборе «Только вручную» время и дни не запускают копии. «При запуске Windows» срабатывает один раз за загрузку при работе службы или после запуска фонового агента.</p>
            }
            else if (model.Step == 3)
            {
                <h2>3. Где хранить копии</h2>
                <h3>Хранилище 1 — основное</h3>
                <label>Папка резервных копий<input name="Model.Destination" value="@model.Destination" maxlength="4096" required placeholder="D:\Копии или \\хранилище\копии" spellcheck="false" /></label>
                <p>Это диск компьютера агента или сетевая папка UNC. Для службы используйте \\сервер\папка вместо буквы подключённого сетевого диска.
                    Доступ проверяется под пользователем агента или службы. Пароль Windows в панели не задаётся.</p>
                <label>Сколько архивов хранить<input name="Model.Keep" value="@model.Keep" inputmode="numeric" maxlength="5" required /></label>
                @for (var index = 0; index < model.AdditionalDestinations.Count; index++)
                {
                    var row = model.AdditionalDestinations[index];
                    <fieldset class="storage-row"><legend>Хранилище @(index + 2)</legend>
                        <label>Дополнительная папка копий<input name="@($"Model.AdditionalDestinations[{index}].Destination")" value="@row?.Destination" maxlength="4096" required placeholder="E:\Копии или \\другой-сервер\копии" spellcheck="false" /></label>
                        <label>Сколько архивов хранить<input name="@($"Model.AdditionalDestinations[{index}].Keep")" value="@row?.Keep" inputmode="numeric" maxlength="5" placeholder="Как в основном хранилище" /></label>
                        <p>Оставьте лимит пустым, чтобы использовать основной. Папка должна находиться отдельно от источника, рабочей папки и других хранилищ.</p>
                        <button type="submit" name="Command" value="@($"remove-storage:{index}")" class="quiet" formnovalidate>Убрать это хранилище из задания</button>
                    </fieldset>
                }
                @if (model.AdditionalDestinations.Count < FileJobDraft.MaxAdditionalDestinations)
                { <button type="submit" name="Command" value="add-storage" class="quiet" formnovalidate>Добавить ещё одну папку копий</button> }
                <p>Можно указать до восьми папок. Архив создаётся один раз и доставляется в каждую папку; ошибка одной доставки не отменяет остальные.
                    Убирая папку из задания, вы не удаляете уже сохранённые архивы.</p>
                <label>Копирование файлов и папок<select name="Model.BackupMode">
                    <option value="Full" selected="@(model.BackupMode == "Full")">Каждый раз полная копия</option>
                    <option value="Incremental" selected="@(model.BackupMode == "Incremental")">Полная основа, затем только изменения</option>
                </select></label>
                <p>Для файловой базы 1С создаётся полный ZIP. Инкрементный режим относится к файлам и папкам.</p>
                <label>Полная копия при инкрементном режиме<select name="Model.FullDay">
                    <option value="" selected="@(model.FullDay == "")">По числу архивов</option>
                    @foreach (var day in FileJobDraft.Days) { var value = ((int)Enum.Parse<DayOfWeek>(day.Key)).ToString(); <option value="@value" selected="@(model.FullDay == value)">@day.Label</option> }
                </select></label>
                <label>Если «По числу архивов»: каждая N-я копия<input name="Model.FullEvery" value="@model.FullEvery" inputmode="numeric" maxlength="3" required /></label>
                <p>Первая копия всегда полная. Если выбранный день пропущен, полная копия выполняется при ближайшем запуске.
                    Цепочка может временно превышать лимит архивов, чтобы оставаться пригодной для восстановления.</p>
                <details><summary>Рабочая папка — при необходимости</summary>
                    <label>Временная папка на агенте<input name="Model.Temporary" value="@model.Temporary" maxlength="4096" placeholder="Оставьте пустой для стандартной папки" spellcheck="false" /></label>
                    <p>Нужно свободное место для архива. Рабочая папка, источник и папка копий должны находиться отдельно.</p>
                </details>
            }
            else
            {
                <h2>4. Проверьте задание</h2>
                <dl><dt>Название</dt><dd>@model.Name</dd><dt>Источник</dt><dd class="path">@model.Source</dd>
                    <dt>Тип</dt><dd>@(model.Kind == "OneCFile" ? "Файловая база 1С — полный ZIP" : "Файлы и папки")</dd>
                    <dt>Расписание</dt><dd>@FileJobDraft.ScheduleLabel(model.Schedule)@if (model.Schedule != "Manual") { <span> · @(model.Enabled ? "включено" : "выключено")</span> }</dd>
                    @if (model.Schedule is "Daily" or "Weekly") { <dt>Время</dt><dd>@model.Times · @ZoneLabel(model.TimeZone)</dd> }
                    @if (model.Schedule == "Weekly") { <dt>Дни</dt><dd>@string.Join(", ", FileJobDraft.Days.Where(d => model.DayValue(d.Key)).Select(d => d.Label))</dd> }
                    <dt>Хранилище 1</dt><dd class="path">@model.Destination<br />Архивов хранить: @model.Keep</dd>
                    @for (var index = 0; index < model.AdditionalDestinations.Count; index++)
                    {
                        var row = model.AdditionalDestinations[index];
                        <dt>Хранилище @(index + 2)</dt><dd class="path">@row?.Destination<br />Архивов хранить: @(string.IsNullOrWhiteSpace(row?.Keep) ? $"как в основном ({model.Keep})" : row.Keep)</dd>
                    }
                    <dt>Режим копирования</dt><dd>@(model.Kind == "OneCFile" || model.BackupMode == "Full" ? "Полные копии" : "Полная основа и изменения")</dd>
                    @if (model.Kind == "FilesAndFolders" && model.BackupMode == "Incremental") { <dt>Следующая полная</dt><dd>@(model.FullDay == "" ? $"Каждая {model.FullEvery}-я копия" : FileJobDraft.Days.FirstOrDefault(d => ((int)Enum.Parse<DayOfWeek>(d.Key)).ToString() == model.FullDay).Label ?? "Выберите день")</dd> }
                    @if (!string.IsNullOrWhiteSpace(model.Temporary)) { <dt>Рабочая папка</dt><dd class="path">@model.Temporary</dd> }
                    @if (model.Kind == "OneCFile") { <dt>Открытая база</dt><dd>@(model.AllowOpen ? "Разрешено архивировать с предупреждением, если база открыта" : "Перед копированием база должна быть закрыта")</dd> }
                </dl>
                <p>Сохранение создаст новую ревизию всего плана агента. Остальные задания сохранятся. Агент проверит настройки при следующем подключении.
                    Наличие папок и права доступа сервер проверить не может: после принятия сделайте тестовую копию на агенте.</p>
            }
            <div class="actions">
                @if (model.Step > 1) { <button type="submit" name="Command" value="back" class="quiet" formnovalidate>Назад</button> }
                @if (!Conflict && model.Step < 4) { <button type="submit" name="Command" value="next">Далее</button> }
                @if (!Conflict && model.Step == 4) { <button type="submit" name="Command" value="publish">Сохранить задание</button> }
                <a href="@($"agents/{Id}/jobs")">Отмена</a>
            </div>
        </form>
    </section>
}
else
{
    <p class="error" role="alert">@(Error ?? "Агент или задание недоступны.")</p>
    @if (Http.HttpContext!.Request.Method == "POST")
    { <form method="post" @formname="job-wizard" @onsubmit="Submit" hidden><AntiforgeryToken /></form> }
}
