@page "/connect"
@attribute [Authorize(Policy = ServerAuthentication.Administrator)]
@inject ServerOptions Settings
@inject ServerStore Store
@inject ServerLog Log
@inject IHttpContextAccessor Http
<PageTitle>Подключить агент — @Settings.DisplayName</PageTitle>
<a href="./">← Агенты</a>
<h1>Подключить агент</h1>
<section class="card narrow">
    @if (Created is { } invitation)
    {
        <h2>Приглашение готово</h2>
        <p>Агент: <strong>@Model!.Name</strong>.</p>
        <p>Папка: @RequestedFolder.</p>
        <p>В Windows-программе откройте «Настройки → Подключения → Подключить по приглашению» и перенесите эти поля.</p>
        <label>Имя сервера<input readonly value="@Settings.DisplayName" /></label>
        <label>Адрес сервера<input readonly value="@ServerAddress" /></label>
        @if (Fingerprint is not null) { <label>SHA-256 сертификата<textarea readonly rows="2">@Fingerprint</textarea></label> }
        <p>Код действует до <strong>@Clock.Time(invitation.ExpiresUtc)</strong> и может быть использован один раз. Скопируйте его сейчас: при повторном открытии он не показывается.</p>
        <label>Код приглашения<textarea readonly rows="2" aria-label="Код приглашения">@invitation.Code</textarea></label>
        <p class="muted">Передайте код только администратору подключаемого компьютера. Это временное разрешение на регистрацию, не пароль пользователя.</p>
        <a href="connect">Создать другое приглашение</a>
    }
    else
    {
        <p class="muted">Создайте одноразовый код и введите его в Windows-программе агента. Текущие задания и расписания сохранятся.</p>
        @if (Error is not null) { <p class="error" role="alert">@Error</p> }
        <form method="post" @formname="invitation" @onsubmit="Create">
            <AntiforgeryToken />
            <label>Понятное имя агента<input name="Model.Name" value="@Model!.Name" maxlength="128" required placeholder="Например, бухгалтерия — основной сервер" /></label>
            <p class="hint">Это имя будет отображаться в панели независимо от имени компьютера. Позже его можно изменить.</p>
            <label>Папка агента<select name="Model.FolderId"><option value="">Без папки</option>
            @foreach (var folder in Folders) { <option value="@folder.Id" selected="@(Model.FolderId == folder.Id.ToString())">@folder.Path</option> }
            </select></label>
            <details><summary>Создать новую папку внутри выбранной</summary>
            <label>Имя новой папки<input name="Model.NewFolderName" value="@Model.NewFolderName" maxlength="128" placeholder="Например, Основной офис" /></label>
            <p class="hint">Если папка не выбрана, новая папка будет на верхнем уровне. Агент будет помещён в новую папку при подключении.</p>
            </details>
            <p><a href="folders">Управление папками и подпапками</a></p>
            <details><summary>Дополнительные параметры подключения</summary>
            <label>ID существующего агента <span class="muted">(необязательно)</span><input name="Model.AgentId" value="@Model.AgentId" maxlength="36" placeholder="UUID агента" /></label>
            <p class="hint">Укажите ID, если код должен подходить только одному конкретному агенту.</p>
            <label>Срок действия, минут<input name="Model.Minutes" value="@Model.Minutes" type="number" min="1" max="60" required /></label>
            </details>
            <button type="submit">Создать приглашение</button>
        </form>
    }
</section>
@code {
    [SupplyParameterFromQuery] public Guid? AgentId { get; set; }
    [SupplyParameterFromQuery] public Guid? FolderId { get; set; }
    [SupplyParameterFromForm] public InviteForm? Model { get; set; }
    private string ServerAddress => Settings.PublicAddress is { } address ? address.TrimEnd('/') + "/"
        : $"https://{Http.HttpContext!.Request.Host}{Http.HttpContext.Request.PathBase}/";
    private string? Fingerprint
    {
        get
        {
            if (Settings.HttpsCertificatePath is not { } path) return null;
            using var cert = System.Security.Cryptography.X509Certificates.X509CertificateLoader.LoadPkcs12FromFile(path,
                Settings.HttpsCertificatePasswordFile is { } password ? ServerHost.ReadSecret(password) : null);
            return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(cert.RawData));
        }
    }
    private string RequestedFolder
    {
        get
        {
            var parent = Folders.FirstOrDefault(f => f.Id.ToString() == Model?.FolderId)?.Path;
            var child = OrganizationText.NewFolder(Model?.NewFolderName);
            return child is null ? parent ?? "Без папки" : parent is null ? child : parent + " / " + child;
        }
    }
    private Invitation? Created; private string? Error;
    private IReadOnlyList<AgentFolderOption> Folders = [];
    protected override async Task OnInitializedAsync()
    {
        var initialize = Model is null;
        Model ??= new() { AgentId = AgentId?.ToString(), FolderId = FolderId?.ToString() };
        Folders = await Store.FoldersAsync(Http.HttpContext!.RequestAborted);
        if (initialize)
        {
            var agent = AgentId is { } id ? await Store.AgentAsync(id, Http.HttpContext.RequestAborted) : null;
            Model = new() { AgentId = AgentId?.ToString(), Name = agent?.Name ?? "", FolderId = (agent?.FolderId ?? FolderId)?.ToString() };
        }
    }
    private async Task Create()
    {
        if (!string.IsNullOrWhiteSpace(Model!.AgentId) && !Guid.TryParse(Model.AgentId, out _)) { Error = "ID агента должен быть UUID. Оставьте поле пустым для нового агента."; return; }
        try
        {
            Created = await Store.InviteAsync(ServerAuthentication.UserId(Http.HttpContext!.User),
                new(Model.Name, string.IsNullOrWhiteSpace(Model.AgentId) ? null : Guid.Parse(Model.AgentId), Model.Minutes,
                    Model.Name, OrganizationText.FolderId(Model.FolderId), OrganizationText.NewFolder(Model.NewFolderName)), Http.HttpContext.RequestAborted);
            Log.Write(ServerEvent.InvitationCreated);
        }
        catch (ServerRequestException error) { Error = error.Code == "invalid_invitation" ? "Проверьте имя, ID агента и срок действия от 1 до 60 минут." : OrganizationText.Error(error); }
    }
    public sealed class InviteForm { public string Name { get; set; } = ""; public string? AgentId { get; set; } public string? FolderId { get; set; } public string? NewFolderName { get; set; } public int Minutes { get; set; } = 30; }
}
