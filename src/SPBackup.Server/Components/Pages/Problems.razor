@page "/problems"
@attribute [Authorize(Policy = ServerAuthentication.Administrator)]
@inject ServerStore Store
@inject ServerOptions Settings
@inject IHttpContextAccessor Http
<PageTitle>Проблемы копирования — @Settings.DisplayName</PageTitle>
<div class="heading"><div><h1>Что требует внимания</h1><p class="muted">Связь, задания, копии и применение плана.</p></div><div class="actions"><a href="@Link(Page)">Обновить</a>
<a href="@PreviewLink">Предпросмотр оповещений</a>
<a href="@Link(0, previousView: !PreviousView)">@(PreviousView ? "Группировать по заданиям" : "Показать список причин")</a></div></div>
<section class="card">
@if (SelectedAgent is { } selected)
{
    <p>Агент: <a href="@($"agents/{selected.AgentId}")">@selected.Name</a> · <a href="@Link(0, clearAgent: true)">Все агенты</a></p>
}
<form method="get" action="problems" class="actions">
@if (Agent is not null) { <input type="hidden" name="agent" value="@Agent" /> }
@if (PreviousView) { <input type="hidden" name="previousView" value="true" /> }
<label>Папка<select name="folder"><option value="">Все агенты</option><option value="root" selected="@(Folder == "root")">Без папки</option>
@foreach (var item in Folders) { <option value="@item.Id" selected="@(Folder == item.Id.ToString())">@item.Path</option> }
</select></label>
<label>Проблема<select name="kind">@foreach (var item in ProblemText.Filters) { <option value="@item.Key" selected="@(Kind == item.Key)">@item.Value</option> }</select></label>
<label>Агент или задание<input name="search" value="@Search" maxlength="128" /></label><button type="submit">Показать</button>
</form>
<p>Подпапки включены. Возраст копии контролируется только при заданном сроке. Проблемы показаны по последним полученным данным;
    при отсутствии связи состояние самого агента может отличаться. Одно задание может иметь несколько причин.</p>
@if (Data is { } data)
{
<p>Агентов: @data.AffectedAgents · Заданий: @data.AffectedJobs · Причин: @data.Total · Страница @(data.Page + 1)</p>
@if (PreviousView)
{
    <div class="table-scroll"><table><thead><tr><th>Агент / задание</th><th>Проблема и действие</th><th>Последняя связь / отчёт</th></tr></thead><tbody>
    @foreach (var item in data.Items)
    {
        <tr><td><a href="@($"agents/{item.AgentId}")">@item.AgentName</a>
            @if (item.JobId is not null) { <small><a href="@TaskLink(item)">@item.JobName</a></small> }
        </td><td><strong>@ProblemText.Title(item)</strong><small>@ProblemText.Action(item)</small></td>
        <td>@Clock.Time(item.LastSeenUtc)<small>Отчёт @Clock.Time(item.ObservedUtc)</small></td></tr>
    }
    </tbody></table></div>
}
else
{
@foreach (var agentGroup in data.Items.GroupBy(item => item.AgentId))
{
    var agent = agentGroup.First();
    <section class="job-summary">
        <h2><a href="@($"agents/{agent.AgentId}")">@agent.AgentName</a></h2>
        <p class="muted">Последняя связь @Clock.Time(agent.LastSeenUtc) · Отчёт @Clock.Time(agent.ObservedUtc)</p>
        @foreach (var jobGroup in agentGroup.GroupBy(item => (item.Scope, item.JobId)))
        {
            var job = jobGroup.First();
            <details>
                <summary>@(job.JobName is null ? "" : job.JobName + " · ")@ProblemText.Title(job)
                    @if (jobGroup.Count() > 1) { <small> · Причин @jobGroup.Count()</small> }
                </summary>
                <ul>
                @foreach (var reason in jobGroup)
                {
                    <li>
                        <strong>@ProblemText.Title(reason)</strong>
                        @if (reason.RunId is { } run)
                        {
                            <span> · @Clock.Time(reason.RunFinishedUtc)</span>
                            <a href="@($"agents/{reason.AgentId}?runId={run}#run-history")">Результат запуска</a>
                        }
                        <small>@ProblemText.Action(reason)</small>
                    </li>
                }
                </ul>
                @if (job.JobId is not null)
                {
                    <p><a href="@TaskLink(job)">@(job.Scope == AgentProblemScope.Observation ? "Открыть наблюдение" : "Открыть задание")</a></p>
                }
            </details>
        }
    </section>
}
}
@if (data.Total == 0)
{
    <p>По выбранным фильтрам проблем не найдено.</p>
    @if (!string.IsNullOrWhiteSpace(Search) || Kind is not (null or "all"))
    {
        <a href="@FilterResetLink">Сбросить поиск и тип проблемы</a>
    }
}
<div class="pagination">@if (Page > 0) { <a href="@Link(Page-1)">← Назад</a> } @if ((Page+1L)*data.PageSize < data.PageItems) { <a href="@Link(Page+1)">Далее →</a> }</div>
}
</section>
@code {
    [SupplyParameterFromQuery] public int Page { get; set; }
    [SupplyParameterFromQuery] public string? Folder { get; set; }
    [SupplyParameterFromQuery] public string? Kind { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Agent { get; set; }
    [SupplyParameterFromQuery] public bool PreviousView { get; set; }
    private AgentRecord? SelectedAgent;
    private IReadOnlyList<AgentFolderOption> Folders = [];
    private AgentProblemPage? Data;
    private string PreviewLink => $"notifications-preview?folder={Uri.EscapeDataString(Folder ?? "")}&search={Uri.EscapeDataString(Search ?? "")}"
        + (Agent is null ? "" : $"&agent={Uri.EscapeDataString(Agent)}")
        + (Kind is not null && ProblemText.NotificationReasons.Contains(Kind) ? $"&kind={Uri.EscapeDataString(Kind)}" : "");
    private string FilterResetLink => $"problems?folder={Uri.EscapeDataString(Folder ?? "")}"
        + (Agent is null ? "" : $"&agent={Uri.EscapeDataString(Agent)}") + ViewParameter(PreviousView);
    private static string TaskLink(AgentProblem problem) => problem.Scope == AgentProblemScope.Observation
        ? $"agents/{problem.AgentId}#observation-{problem.JobId}" : $"agents/{problem.AgentId}#job-{problem.JobId}";
    private static string ViewParameter(bool previousView) => previousView ? "&previousView=true" : "";
    private string Link(int page, bool clearAgent = false, bool? previousView = null) => $"problems?page={page}&folder={Uri.EscapeDataString(Folder ?? "")}&kind={Uri.EscapeDataString(Kind ?? "all")}&search={Uri.EscapeDataString(Search ?? "")}" + (clearAgent || Agent is null ? "" : $"&agent={Uri.EscapeDataString(Agent)}") + ViewParameter(previousView ?? PreviousView);
    protected override async Task OnParametersSetAsync()
    {
        Folders = await Store.FoldersAsync(Http.HttpContext!.RequestAborted);
        var folder = string.IsNullOrEmpty(Folder) || Folder == "root" ? (Guid?)null : OrganizationText.FolderId(Folder);
        Guid? agentId = null;
        if (Agent is not null)
        {
            if (!Guid.TryParse(Agent, out var id) || id == Guid.Empty) throw new ServerRequestException(400, "invalid_problem_filter");
            agentId = id;
            SelectedAgent = await Store.AgentAsync(id, Http.HttpContext.RequestAborted) ?? throw new ServerRequestException(404, "agent_not_found");
        }
        else SelectedAgent = null;
        Data = await Store.ProblemsAsync(Page, Kind, Search, folder, Folder == "root", Settings.OfflineAfterSeconds, Http.HttpContext.RequestAborted, agentId, groupByJob: !PreviousView);
    }
}
