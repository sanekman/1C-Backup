@page "/agents/{Id:guid}/jobs"
@attribute [Authorize(Policy = ServerAuthentication.Administrator)]
@inject ServerStore Store
@inject IHttpContextAccessor Http
@inject ServerOptions Settings
@using SPBackup.Server.Monitoring
<PageTitle>Задания агента — @Settings.DisplayName</PageTitle>
<a href="@($"agents/{Id}")">← Карточка агента</a>
<h1>Задания на сервере</h1>
@if (Agent is { } agent)
{
    <p>@agent.Name. Пути и расписание относятся к этому компьютеру агента.</p>
    @if (agent.Revoked) { <p class="error">Доступ агента отозван. Изменение заданий недоступно до повторного подключения.</p> }
    @if (Error is not null) { <p class="error" role="alert">@Error</p> }
    @if (Configuration is { } configuration)
    {
        <section class="card">
            <div class="heading"><h2>Сохранённая ревизия @configuration.Revision</h2>
                @if (!agent.Revoked) { <a class="button" href="@($"agents/{Id}/jobs/new")">Создать задание</a> }</div>
            <p>После сохранения агент должен получить и принять настройки. Это ещё не означает, что копия создана.
                Принятие ревизии и результаты копирования показаны в <a href="@($"agents/{Id}")">карточке агента</a>.</p>
            <p><a href="@($"agents/{Id}/jobs/history")">История планов и возврат к прежним настройкам</a> · <a href="@($"agents/{Id}/commands")">Удалённые запуски</a></p>
            <p class="muted">В Windows-программе подключите сервер по приглашению, выберите «Задания с сервера», примените режим и включите автоматическую работу.
                При недоступном сервере агент продолжает последний принятый план.</p>
            @if (configuration.Jobs.Count == 0) { <p>Заданий пока нет. Создайте первое: выберите источник, время и папку копий.</p> }
            @foreach (var job in configuration.Jobs)
            {
                <article class="job-summary">
                    <h3>@job.Name</h3><p>@(job.Kind == "OneCFile" ? "Файловая база 1С, архив ZIP" : "Файлы и папки")</p>
                    <dl><dt>Источник</dt><dd class="path">@job.Source</dd><dt>Хранилище 1</dt><dd class="path">@job.DestinationDirectory<br />Архивов хранить: @job.KeepLast</dd>
                        @for (var index = 0; index < (job.AdditionalDestinations?.Count ?? 0); index++)
                        {
                            var destination = job.AdditionalDestinations![index];
                            <dt>Хранилище @(index + 2)</dt><dd class="path">@destination.DestinationDirectory<br />Архивов хранить: @(destination.KeepLast is { } keep ? keep.ToString() : $"как в основном ({job.KeepLast})")</dd>
                        }
                        <dt>Запуск</dt><dd>@FileJobDraft.ScheduleLabel(job.ScheduleKind)@if (job.ScheduleKind != "Manual") { <span> · @(job.Enabled ? "расписание включено" : "расписание выключено")</span> }</dd></dl>
                    @if (job.ManagedSecrets is { } access) { <p>Защищённый доступ задаётся на агенте: @(access.ArchivePassword ? "пароль AES-256; " : "") отдельный сетевой вход для хранилищ: @string.Join(", ", access.NetworkDestinations.Select(i => i + 1)). В Windows-программе: «Файл → Доступ серверного задания…».</p> }
                    @if (!agent.Revoked)
                    { <div class="actions"><a href="@($"agents/{Id}/jobs/{job.Id}/run")">Запустить…</a><a href="@($"agents/{Id}/jobs/{job.Id}/edit")">Изменить</a><a href="@($"agents/{Id}/jobs/{job.Id}/copy")">Создать на основе…</a><a href="@($"agents/{Id}/jobs/{job.Id}/remove")">Удалить…</a></div> }
                </article>
            }
        </section>
    }
    @if (ObservationTasks.Count > 0)
    {
        <section class="card">
            <h2>Задания наблюдения SQL</h2>
            <p>Эти задания читают журнал копий выбранной базы. Настройки меняются в Windows-программе агента, в общем списке заданий.
                Результаты и история доступны в <a href="@($"agents/{Id}")">карточке агента</a>.</p>
            @foreach (var task in ObservationTasks)
            {
                <article class="job-summary"><h3>@task.Name</h3>
                    <p>@(task.SourceKind == "SqlServerHistory" ? "Наблюдение MS SQL" : "Наблюдение PostgreSQL") · @(task.Enabled ? task.Schedule : "Опрос выключен")</p>
                </article>
            }
        </section>
    }
}
else { <p>Агент не найден.</p> }
@code {
    [Parameter] public Guid Id { get; set; }
    private AgentRecord? Agent;
    private ManagedFileConfiguration? Configuration;
    private string? Error;
    private IReadOnlyList<MonitoredJob> ObservationTasks = [];
    protected override async Task OnParametersSetAsync()
    {
        Agent = await Store.AgentAsync(Id, Http.HttpContext!.RequestAborted);
        if (Agent is null) { Http.HttpContext.Response.StatusCode = 404; return; }
        var monitoring = await Store.MonitoringAsync(Id, Http.HttpContext.RequestAborted);
        ObservationTasks = monitoring?.Snapshot.Jobs.Where(job => job.TaskKind == "Observation").ToArray() ?? [];
        try { Configuration = await Store.ReadFileConfigurationAsync(Id, Http.HttpContext.RequestAborted); }
        catch (ServerRequestException) { Error = "Эта конфигурация содержит параметры, которые мастер пока не поддерживает. Она сохранена без изменений."; }
    }
}
