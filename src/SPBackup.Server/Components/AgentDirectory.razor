@using SPBackup.Server.Monitoring
@inject ServerStore Store
@inject ServerOptions Settings
@inject IHttpContextAccessor Http

<div class="agent-directory dashboard" data-agent-directory data-initial-branch="@BranchKey" data-dashboard-compact="@(Compact ? "true" : null)">
    @if (Compact)
    {
        <script type="application/json" data-agent-index>@((MarkupString)AgentIndex)</script>
    }
    <div class="dashboard-tools">
        @if (Compact)
        {
            <form method="get" class="agent-directory-filter dashboard-search-form">
                <input type="hidden" name="view" value="compact" />
                <input type="hidden" name="branch" value="@BranchKey" />
                <label class="dashboard-search">Найти агента<input type="search" maxlength="128" name="q" value="@SearchQuery" data-agent-search /></label>
                <label class="agent-attention-filter"><input type="checkbox" name="attention" value="true" checked="@Attention" data-agent-attention /> Требуют внимания</label>
                <button type="submit" class="secondary">Найти</button>
                @if (Filtering) { <a href="@FolderLink(BranchKey, true)">Сбросить</a> }
            </form>
        }
        else
        {
        <div class="agent-directory-filter" data-agent-filter hidden>
            <label class="dashboard-search">Найти агента<input type="search" maxlength="128" data-agent-search /></label>
            <label class="agent-attention-filter"><input type="checkbox" data-agent-attention /> Требуют внимания</label>
            <button type="button" class="secondary" data-agent-reset>Сбросить</button>
        </div>
        }
        <span data-dashboard-active>Сейчас работают: @Rows.Count(row => row.Current is { Stale: false })</span>
        <a href="" data-dashboard-refresh>Обновить</a>
        <span class="muted" data-dashboard-refresh-status role="status" hidden></span>
    </div>
    <div class="dashboard-panes">
        <aside class="dashboard-tree" aria-label="Дерево папок">
            <div class="dashboard-tree-tools" data-agent-filter hidden>
                <button type="button" data-folder-op="create">Новая папка</button>
                <button type="button" class="secondary" data-folder-op="rename" disabled>Переименовать</button>
                <button type="button" class="secondary" data-folder-op="folder-move" disabled>Переместить</button>
                <button type="button" class="secondary" data-folder-op="delete" disabled>Удалить</button>
            </div>
            <ul class="dashboard-nodes">
                <li><a href="@FolderLink("all", Compact)" data-folder-key="all" data-folder-path="Все агенты" aria-current="@(BranchKey == "all" ? "true" : null)">Все агенты (@Rows.Count)</a></li>
                @foreach (var folder in Branches)
                {
                    <AgentDirectoryBranch Branch="folder" SelectedId="AgentId" BranchKey="@BranchKey" Compact="Compact" />
                }
            </ul>
        </aside>
        <section class="dashboard-results" aria-label="Состояние агентов">
            <div class="dashboard-results-title">
                <strong data-dashboard-title>@(Compact ? ResultsTitle : "Все агенты")</strong>
                @if (Compact && PageCount > 1)
                {
                    <nav class="dashboard-pager" aria-label="Страницы агентов">
                        @if (CurrentPage > 0) { <a href="@ResultsLink(CurrentPage - 1)" aria-label="Предыдущая страница агентов">←</a> }
                        <span class="muted" data-dashboard-count aria-live="polite">@ResultRange</span>
                        @if (CurrentPage + 1 < PageCount) { <a href="@ResultsLink(CurrentPage + 1)" aria-label="Следующая страница агентов">→</a> }
                    </nav>
                }
                else
                { <span class="muted" data-dashboard-count aria-live="polite">@(Compact ? ResultRange : "")</span> }
            </div>
            <div class="dashboard-table-scroll">
                <table class="dashboard-table">
                    <colgroup><col class="dashboard-col-agent" /><col class="dashboard-col-state" /><col class="dashboard-col-active" /><col /><col class="dashboard-col-actions" /></colgroup>
                    <thead><tr><th>Агент</th><th>Связь</th><th>Сейчас</th><th>Последний запуск</th><th aria-label="Действия"></th></tr></thead>
                    <tbody>
                    @foreach (var row in VisibleRows)
                    {
                        <tr data-dashboard-row data-agent-id="@row.Entry.Id" data-folder-id="@row.Entry.FolderId"
                            data-folder-path="@FolderPath(row)" data-agent-name="@row.Entry.Name" data-computer-name="@row.Entry.ComputerName"
                            data-attention="@(row.NeedsAttention ? "yes" : "no")" draggable="true"
                            class="@(row.Entry.Id == AgentId ? "dashboard-selected" : null)">
                            <td><a href="@AgentLink(row.Entry.Id, "agent-summary")">@row.Entry.Name</a></td>
                            <td data-dashboard-live><strong class="@row.ConnectionColor">@row.Connection</strong>
                                @if (row.PrimaryReason is { } reason) { <small class="@ProblemColor(reason.Code)">@ProblemText.Filters[reason.Code]</small> }
                                else if (row.Reasons.Any(reason => reason.Code != "Offline" && !row.ShowsPlanReason(reason.Code)))
                                { <small><a href="@($"problems?agent={row.Entry.Id}")">Причины</a></small> }
                                else if (row.Entry.LastSeen is { } seen) { <small title="@Clock.Time(seen)">@Clock.Time(seen, "dd.MM HH:mm")</small> }
                                @if (row.Plan is { NeedsAttention: true } plan)
                                {
                                    <small data-managed-plan>
                                        <a href="@AgentLink(row.Entry.Id, "agent-plan")" class="@(plan.Rejected ? "dashboard-error" : plan.RevisionDiffers ? "dashboard-warn" : null)">@plan.PlanLabel</a>
                                        @if (plan.Rejected) { <span class="dashboard-error"> · отклонён</span> }
                                        @if (plan.AcceptedRevision is { } accepted && plan.ReportedRevision is { } reported && accepted != reported)
                                        { <span class="dashboard-warn" title="@Clock.Time(plan.ReportedUtc)"> · по отчёту @reported</span> }
                                    </small>
                                    <small class="@(plan.ExecutorReady == false ? "dashboard-error" : plan.ExecutorReady is null ? "dashboard-warn" : null)" title="@Clock.Time(plan.ExecutorObservedUtc)">@plan.ExecutorLabel</small>
                                    @if (plan.AccessStale || plan.MissingAccess > 0)
                                    {
                                        <small class="@(plan.AccessStale ? "dashboard-warn" : "dashboard-error")" title="@Clock.Time(plan.AccessUtc)">@(plan.AccessStale ? "Сведения о доступе устарели" : plan.AccessLabel)</small>
                                    }
                                }
                            </td>
                            <td data-dashboard-live>
                                @if (row.Current is { } activity)
                                {
                                    <strong>@row.CurrentJob</strong>
                                    <small><span class="@(activity.Stale ? "dashboard-warn" : null)">@(activity.Stale ? "Прогресс устарел · " : "")@activity.Label</span>
                                        · <time title="@Clock.Time(activity.ObservedUtc)" datetime="@activity.ObservedUtc.ToString("O")">@Clock.Time(activity.ObservedUtc, "dd.MM HH:mm")</time></small>
                                }
                                else { <span class="muted">—</span> }
                            </td>
                            <td data-dashboard-live>
                                @if (row.Entry.LatestRun is { } run)
                                { <strong>@run.JobName</strong><small title="@Clock.Time(run.DisplayFinishedUtc)"><span class="@DeliveryColor(run)">@Delivery(run)</span> · @Clock.Time(run.DisplayFinishedUtc, "dd.MM HH:mm")</small> }
                                else { <span class="muted">—</span> }
                            </td>
                            <td><button type="button" class="dashboard-text-button" data-agent-move aria-label="@($"Переместить {row.Entry.Name} в папку")" title="Переместить в папку">⇄</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <p data-agent-no-match hidden="@(!Compact || MatchingCount != 0)" role="status">В этом разделе нет подходящих агентов.</p>
            </div>
        </section>
    </div>
    @if (AgentId is not null) {
    <section id="agent-summary" class="dashboard-summary" aria-label="Сводка агента" tabindex="-1">
        @if (Selected is { } row)
        {
            <p class="muted">@FolderPath(row)</p>
            <h2>@row.Entry.Name</h2>
            <dl>
                <dt>Связь</dt><dd class="@row.ConnectionColor">@row.Connection</dd>
                <dt>Последняя связь</dt><dd>@Clock.Time(row.Entry.LastSeen)</dd>
                <dt>Последний отчёт</dt><dd>@Clock.Time(row.Entry.Observed)</dd>
                @if (row.Current is { } activity)
                {
                    <dt>@(activity.Stale ? "Устаревший прогресс" : "Текущий прогресс")</dt>
                    <dd><span class="@(activity.Stale ? "dashboard-warn" : null)">@row.CurrentJob · @activity.Label</span>
                        <small>Последнее изменение @Clock.Time(activity.ObservedUtc)</small></dd>
                }
                <dt>Доставка по отчёту</dt>
                <dd>
                    @if (Latest is { } run)
                    {
                        <span class="@DeliveryColor(run)">@Delivery(run)</span>
                        <small>@run.JobName · @Clock.Time(run.DisplayFinishedUtc)</small>
                        @if (HasCurrentJob)
                        { <a href="@($"agents/{row.Entry.Id}#job-{run.JobId}")">Открыть задание</a> }
                        else
                        { <a href="@($"agents/{row.Entry.Id}#run-history")">История запусков</a> }
                    }
                    else { <span>Данных о копировании пока нет.</span> }
                </dd>
            </dl>
            @if (row.Plan is { } plan)
            {
                <h3 id="agent-plan" tabindex="-1">Серверный план и готовность</h3>
                <dl><ManagedPlanDetails Status="plan" /></dl>
            }
            @if (!row.Entry.Revoked && SelectedMonitoring is { } monitoring && monitoring.Snapshot.Jobs.Any(job => job.FileCopyChecks is not null))
            {
                <h3>Проверенные файловые копии</h3>
                <p class="muted">@(monitoring.ReceivedUtc < Cutoff ? "Отчёт устарел · " : "")Отчёт агента получен @Clock.Time(monitoring.ReceivedUtc)</p>
                @foreach (var job in monitoring.Snapshot.Jobs.Where(job => job.FileCopyChecks is not null))
                {
                    <details data-dashboard-disclosure="@job.JobId" open="@(job.JobId == Latest?.JobId)">
                        <summary>@job.Name</summary>
                        <FileCopyChecks Checks="job.FileCopyChecks!" />
                    </details>
                }
            }
            @if (row.Reasons.Count > 0)
            {
                <ul>
                    @foreach (var reason in row.Reasons)
                    {
                        <li><span class="@ProblemColor(reason.Code)">@ProblemText.Filters[reason.Code]</span> <span class="muted">(@reason.Count)</span></li>
                    }
                </ul>
                <p><a href="@($"problems?agent={row.Entry.Id}")">Проблемы агента →</a></p>
            }
            <h3>Недавние завершённые задания</h3>
            <ul class="dashboard-history">
                @foreach (var completed in Recent)
                { <li><strong>@completed.JobName</strong> · <span class="@DeliveryColor(completed)">@Delivery(completed)</span> · @Clock.Time(completed.DisplayFinishedUtc)</li> }
            </ul>
            <p><a href="@($"agents/{row.Entry.Id}")">Карточка агента и вся история →</a></p>
        }
        else if (AgentId is not null)
        {
            <h2>Агент не найден</h2>
            <p>Выберите компьютер в дереве.</p>
        }
    </section>
    }
</div>
<script src="agent-directory.js" defer></script>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AgentFolderOption> Folders { get; set; } = [];
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public string BranchKey { get; set; } = "all";

    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Query { get; set; }
    [Parameter] public bool Attention { get; set; }
    [Parameter] public int RowsPage { get; set; }

    private const int RowsPerPage = 50;
    private IReadOnlyList<AgentRow> VisibleRows = [];
    private string SearchQuery = "";
    private bool Filtering => SearchQuery.Length != 0 || Attention;
    private int CurrentPage;
    private int PageCount;
    private int MatchingCount;
    private string ResultRange => MatchingCount == 0 ? "0"
        : $"{CurrentPage * RowsPerPage + 1}–{CurrentPage * RowsPerPage + VisibleRows.Count} из {MatchingCount}";
    private string ResultsTitle = "Все агенты";
    private string AgentIndex = "";
    private Dictionary<Guid, AgentFolderOption> FolderLookup = [];
    private IReadOnlyList<BranchNode> Branches = [];
    private IReadOnlyList<AgentRow> Rows = [];
    private IReadOnlyList<MonitoredRun> Recent = [];
    private AgentRow? Selected;
    private MonitoredRun? Latest;
    private bool HasCurrentJob;
    private MonitoringState? SelectedMonitoring;
    private DateTimeOffset Cutoff;

    public sealed record BranchNode(string Key, string Label, Guid? FolderId, IReadOnlyList<BranchNode> Children,
        IReadOnlyList<AgentRow> Agents, string Path, string Parent)
    {
        public int Count { get; } = Agents.Count + Children.Sum(child => child.Count);
        public bool Contains(Guid id) => Agents.Any(agent => agent.Entry.Id == id) || Children.Any(child => child.Contains(id));
        public bool ContainsBranch(string key) => Key == key || Children.Any(child => child.ContainsBranch(key));
    }

    public sealed record AgentRow(AgentTreeEntry Entry, string Connection, string ConnectionColor, IReadOnlyList<AgentProblemCount> Reasons)
    {
        public AgentProblemCount? PrimaryReason => Reasons.FirstOrDefault(reason => reason.Code != "Offline" && !RepeatsLatestRun(reason) && !ShowsPlanReason(reason.Code));
        internal bool NeedsAttention => Reasons.Count != 0 || Plan?.NeedsAttention == true;
        internal ManagedPlanStatus? Plan { get; init; }
        internal bool ShowsPlanReason(string code) => Plan is { NeedsAttention: true } plan && (code switch
        {
            "PlanPending" or "PlanRejected" or "ExecutorUnavailable" => true,
            "AccessRequired" => plan.MissingAccess > 0,
            _ => false
        });

        private bool RepeatsLatestRun(AgentProblemCount reason) => Entry.LatestRun is { } run && reason.Code switch
        {
            "Failed" or "Interrupted" or "Cancelled" => reason.Count == 1 && reason.Code == run.Status,
            "Partial" => reason.Count == 1 && run.Status == "PartiallySucceeded",
            "Warning" => reason.Count == 1 && run.Status == "Succeeded" && run.WarningCount > 0,
            _ => false
        };
        internal MonitoringProgressDisplay? Current { get; init; }
        public string CurrentJob => Entry.ProgressJob ?? "Копирование";
    }

    protected override async Task OnParametersSetAsync()
    {
        var token = Http.HttpContext!.RequestAborted;
        var entries = await Store.AgentTreeAsync(token);
        var problems = (await Store.TreeProblemSummariesAsync(Settings.OfflineAfterSeconds, token)).ToDictionary(problem => problem.AgentId);
        var cutoff = DateTimeOffset.UtcNow.AddSeconds(-Settings.OfflineAfterSeconds);
        Cutoff = cutoff;
        var plans = await Store.ManagedPlansAsync(null, cutoff, token);
        FolderLookup = Folders.ToDictionary(folder => folder.Id);
        var rows = entries.Select(entry =>
        {
            var reasons = problems.GetValueOrDefault(entry.Id)?.Reasons.OrderBy(reason => ProblemText.Priority(reason.Code))
                .ThenBy(reason => reason.Code, StringComparer.Ordinal).ToArray() ?? [];
            var (connection, color) = entry.Revoked ? ("Доступ отозван", "dashboard-error")
                : entry.LastSeen is null ? ("Ожидает первого сигнала", "dashboard-warn")
                : entry.LastSeen < cutoff ? ("Нет связи", "dashboard-error")
                : ("На связи", "dashboard-good");
            var current = entry.Observed is { } received
                ? MonitoringProgressDisplay.Create(entry.Progress, entry.ProgressObservedUtc, received, entry.Revoked, entry.ProgressCompleted, cutoff)
                : null;
            return new AgentRow(entry, connection, color, reasons) { Current = current, Plan = plans.GetValueOrDefault(entry.Id) };
        }).ToLookup(row => row.Entry.FolderId is { } id && FolderLookup.ContainsKey(id) ? id : Guid.Empty);
        var children = Folders.ToLookup(folder => folder.ParentId ?? Guid.Empty);
        BranchNode Build(AgentFolderOption folder) => new(folder.Id.ToString(), folder.Name, folder.Id,
            children[folder.Id].Select(Build).ToArray(), rows[folder.Id].ToArray(), folder.Path, folder.ParentId?.ToString() ?? "all");
        Branches = children[Guid.Empty].Select(Build)
            .Append(new("root", "Без папки", null, [], rows[Guid.Empty].ToArray(), "Без папки", "all")).ToArray();
        Rows = rows.SelectMany(group => group).OrderByDescending(row => row.Current is { Stale: false })
            .ThenByDescending(row => row.NeedsAttention).ThenBy(row => row.Entry.Name, StringComparer.CurrentCultureIgnoreCase).ToArray();
        Selected = AgentId is { } selected ? Rows.FirstOrDefault(row => row.Entry.Id == selected) : null;
        VisibleRows = Rows;
        if (Compact) PrepareCompactRows();
        Latest = Selected?.Entry.LatestRun;
        if (Selected is { } item) Recent = (await Store.RunsAsync(item.Entry.Id, 0, token, agentCopiesOnly: true)).Runs.Take(8).ToArray();
        SelectedMonitoring = Selected is { } current ? await Store.MonitoringAsync(current.Entry.Id, token) : null;
        HasCurrentJob = Latest is { } run && SelectedMonitoring?.Snapshot.Jobs.Any(job => job.JobId == run.JobId) == true;
    }

    private void PrepareCompactRows()
    {
        SearchQuery = (Query ?? "").Trim();
        if (SearchQuery.Length > 128) SearchQuery = SearchQuery[..(char.IsHighSurrogate(SearchQuery[127]) ? 127 : 128)];
        var folder = Guid.TryParse(BranchKey, out var id) ? FolderLookup.GetValueOrDefault(id) : null;
        ResultsTitle = Filtering ? "Результаты по всем папкам" : folder?.Path ?? (BranchKey == "root" ? "Без папки" : "Все агенты");
        var query = SearchQuery.Normalize();
        var matching = Rows.Where(row => Filtering
            ? (!Attention || row.NeedsAttention) && $"{row.Entry.Name} {row.Entry.ComputerName}".Normalize().Contains(query, StringComparison.OrdinalIgnoreCase)
            : FolderMatches(row, folder)).ToArray();
        MatchingCount = matching.Length;
        PageCount = (MatchingCount + RowsPerPage - 1) / RowsPerPage;
        CurrentPage = Math.Clamp(RowsPage, 0, Math.Max(0, PageCount - 1));
        VisibleRows = matching.Skip(CurrentPage * RowsPerPage).Take(RowsPerPage).ToArray();
        // Default JSON escaping keeps user-supplied names inert inside the script data element.
        var matchIds = Filtering ? matching.Select(row => row.Entry.Id).ToHashSet() : null;
        AgentIndex = System.Text.Json.JsonSerializer.Serialize(Rows.OrderBy(row => row.Entry.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(row => row.Entry.Id).Select(row => new
            {
                id = row.Entry.Id,
                name = row.Entry.Name,
                folder = row.Entry.FolderId,
                matches = matchIds?.Contains(row.Entry.Id) == true
            }));
    }

    private bool FolderMatches(AgentRow row, AgentFolderOption? folder)
    {
        if (BranchKey == "root") return row.Entry.FolderId is null;
        if (folder is null) return true;
        for (var id = row.Entry.FolderId; id is { } current; id = FolderLookup.GetValueOrDefault(current)?.ParentId)
            if (current == folder.Id) return true;
        return false;
    }

    public static string FolderLink(string key, bool compact) =>
        $"?{(compact ? "view=compact&" : "")}branch={Uri.EscapeDataString(key)}";

    private string ResultsLink(int page) => FolderLink(BranchKey, true)
        + $"&rows={page}&q={Uri.EscapeDataString(SearchQuery)}&attention={Attention.ToString().ToLowerInvariant()}";
    private string AgentLink(Guid agent, string target) => (Compact ? ResultsLink(CurrentPage) + "&" : "?") + $"agent={agent}#{target}";
    private string FolderPath(AgentRow row) => row.Entry.FolderId is { } id ? FolderLookup.GetValueOrDefault(id)?.Path ?? "Без папки" : "Без папки";

    private static string ProblemColor(string code) => code switch
    {
        "Offline" or "Failed" or "PollFailed" or "AccessRequired" or "PlanRejected" or "ExecutorUnavailable" => "dashboard-error",
        _ => "dashboard-warn"
    };

    private static string DeliveryColor(MonitoredRun run) => run.Status switch
    {
        "Failed" or "Interrupted" => "dashboard-error",
        "Succeeded" when !run.Incomplete && run.WarningCount == 0 && run.Destinations.Any(destination => destination.Succeeded) => "dashboard-good",
        _ => "dashboard-warn"
    };

    private static string Delivery(MonitoredRun run)
    {
        var delivered = run.Destinations.Count(destination => destination.Succeeded);
        return run.Status switch
        {
            "Succeeded" when run.Incomplete => "Доставлено с пропусками",
            "Succeeded" when run.WarningCount > 0 && delivered > 0 => $"Доставлено с предупреждениями · {delivered}",
            "Succeeded" when delivered > 0 => $"Доставлено в хранилища: {delivered}",
            "PartiallySucceeded" => $"Частичная доставка · {delivered} из {run.Destinations.Count}",
            "Cancelled" => "Копирование отменено",
            "Interrupted" => "Копирование прервано",
            "Failed" => "Ошибка копирования",
            _ => "Доставка не подтверждена"
        };
    }
}
