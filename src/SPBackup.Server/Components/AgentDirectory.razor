@using SPBackup.Server.Monitoring
@inject ServerStore Store
@inject ServerOptions Settings
@inject IHttpContextAccessor Http

<div class="agent-directory dashboard" data-agent-directory data-initial-branch="@BranchKey">
    <div class="dashboard-tools">
        <div class="agent-directory-filter" data-agent-filter hidden>
            <label class="dashboard-search">Найти агента<input type="search" maxlength="128" data-agent-search /></label>
            <label class="agent-attention-filter"><input type="checkbox" data-agent-attention /> Требуют внимания</label>
            <button type="button" class="secondary" data-agent-reset>Сбросить</button>
        </div>
        <span>Сейчас работают: @Rows.Count(row => row.Current is not null)</span>
        <a href="" data-dashboard-refresh>Обновить</a>
    </div>
    <div class="dashboard-panes">
        <aside class="dashboard-tree" aria-label="Дерево папок">
            <div class="dashboard-tree-tools" data-agent-filter hidden>
                <button type="button" data-folder-op="create">Новая папка</button>
                <button type="button" class="secondary" data-folder-op="rename" disabled>Переименовать</button>
                <button type="button" class="secondary" data-folder-op="folder-move" disabled>Переместить</button>
                <button type="button" class="secondary" data-folder-op="delete" disabled>Удалить</button>
            </div>
            <ul class="dashboard-nodes">
                <li><a href="?branch=all" data-folder-key="all" data-folder-path="Все агенты" aria-current="@(BranchKey == "all" ? "true" : null)">Все агенты (@Rows.Count)</a></li>
                @foreach (var folder in Branches)
                {
                    <AgentDirectoryBranch Branch="folder" SelectedId="AgentId" BranchKey="@BranchKey" />
                }
            </ul>
        </aside>
        <section class="dashboard-results" aria-label="Состояние агентов">
            <div class="dashboard-results-title"><strong data-dashboard-title>Все агенты</strong><span class="muted" data-dashboard-count aria-live="polite"></span></div>
            <div class="dashboard-table-scroll">
                <table class="dashboard-table">
                    <colgroup><col class="dashboard-col-agent" /><col class="dashboard-col-state" /><col class="dashboard-col-active" /><col /><col class="dashboard-col-actions" /></colgroup>
                    <thead><tr><th>Агент</th><th>Связь</th><th>Сейчас</th><th>Последний запуск</th><th aria-label="Действия"></th></tr></thead>
                    <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr data-dashboard-row data-agent-id="@row.Entry.Id" data-folder-id="@row.Entry.FolderId"
                            data-folder-path="@FolderPath(row)" data-agent-name="@row.Entry.Name" data-computer-name="@row.Entry.ComputerName"
                            data-attention="@(row.Reasons.Count != 0 ? "yes" : "no")" draggable="true"
                            class="@(row.Entry.Id == AgentId ? "dashboard-selected" : null)">
                            <td><a href="@($"?agent={row.Entry.Id}#agent-summary")">@row.Entry.Name</a></td>
                            <td><strong class="@row.ConnectionColor">@row.Connection</strong>
                                @if (row.PrimaryReason is { } reason) { <small class="@ProblemColor(reason.Code)">@ProblemText.Filters[reason.Code]</small> }
                                else if (row.Reasons.Any(reason => reason.Code != "Offline"))
                                { <small><a href="@($"problems?agent={row.Entry.Id}")">Причины</a></small> }
                                else if (row.Entry.LastSeen is { } seen) { <small title="@Clock.Time(seen)">@Clock.Time(seen, "dd.MM HH:mm")</small> }
                            </td>
                            <td>
                                @if (row.Current is { } activity)
                                {
                                    <strong>@row.CurrentJob</strong><small>@ProgressLabel(activity)</small>
                                }
                                else { <span class="muted">—</span> }
                            </td>
                            <td>
                                @if (row.Entry.LatestRun is { } run)
                                { <strong>@run.JobName</strong><small title="@Clock.Time(run.FinishedUtc)"><span class="@DeliveryColor(run)">@Delivery(run)</span> · @Clock.Time(run.FinishedUtc, "dd.MM HH:mm")</small> }
                                else { <span class="muted">—</span> }
                            </td>
                            <td><button type="button" class="dashboard-text-button" data-agent-move aria-label="@($"Переместить {row.Entry.Name} в папку")" title="Переместить в папку">⇄</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <p data-agent-no-match hidden role="status">В этом разделе нет подходящих агентов.</p>
            </div>
        </section>
    </div>
    @if (AgentId is not null) {
    <section id="agent-summary" class="dashboard-summary" aria-label="Сводка агента" tabindex="-1">
        @if (Selected is { } row)
        {
            <p class="muted">@FolderPath(row)</p>
            <h2>@row.Entry.Name</h2>
            <dl>
                <dt>Связь</dt><dd class="@row.ConnectionColor">@row.Connection</dd>
                <dt>Последняя связь</dt><dd>@Clock.Time(row.Entry.LastSeen)</dd>
                <dt>Последний отчёт</dt><dd>@Clock.Time(row.Entry.Observed)</dd>
                <dt>Доставка по отчёту</dt>
                <dd>
                    @if (Latest is { } run)
                    {
                        <span class="@DeliveryColor(run)">@Delivery(run)</span>
                        <small>@run.JobName · @Clock.Time(run.FinishedUtc)</small>
                        @if (HasCurrentJob)
                        { <a href="@($"agents/{row.Entry.Id}#job-{run.JobId}")">Открыть задание</a> }
                        else
                        { <a href="@($"agents/{row.Entry.Id}#run-history")">История запусков</a> }
                    }
                    else { <span>Данных о копировании пока нет.</span> }
                </dd>
            </dl>
            @if (row.Reasons.Count > 0)
            {
                <ul>
                    @foreach (var reason in row.Reasons)
                    {
                        <li><span class="@ProblemColor(reason.Code)">@ProblemText.Filters[reason.Code]</span> <span class="muted">(@reason.Count)</span></li>
                    }
                </ul>
                <p><a href="@($"problems?agent={row.Entry.Id}")">Проблемы агента →</a></p>
            }
            <h3>Недавние завершённые задания</h3>
            <ul class="dashboard-history">
                @foreach (var completed in Recent)
                { <li><strong>@completed.JobName</strong> · <span class="@DeliveryColor(completed)">@Delivery(completed)</span> · @Clock.Time(completed.FinishedUtc)</li> }
            </ul>
            <p><a href="@($"agents/{row.Entry.Id}")">Карточка агента и вся история →</a></p>
        }
        else if (AgentId is not null)
        {
            <h2>Агент не найден</h2>
            <p>Выберите компьютер в дереве.</p>
        }
    </section>
    }
</div>
<script src="agent-directory.js" defer></script>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AgentFolderOption> Folders { get; set; } = [];
    [Parameter] public Guid? AgentId { get; set; }
    [Parameter] public string BranchKey { get; set; } = "all";

    private IReadOnlyList<BranchNode> Branches = [];
    private IReadOnlyList<AgentRow> Rows = [];
    private IReadOnlyList<MonitoredRun> Recent = [];
    private AgentRow? Selected;
    private MonitoredRun? Latest;
    private bool HasCurrentJob;

    public sealed record BranchNode(string Key, string Label, Guid? FolderId, IReadOnlyList<BranchNode> Children,
        IReadOnlyList<AgentRow> Agents, string Path, string Parent)
    {
        public int Count { get; } = Agents.Count + Children.Sum(child => child.Count);
        public bool Contains(Guid id) => Agents.Any(agent => agent.Entry.Id == id) || Children.Any(child => child.Contains(id));
        public bool ContainsBranch(string key) => Key == key || Children.Any(child => child.ContainsBranch(key));
    }

    public sealed record AgentRow(AgentTreeEntry Entry, string Connection, string ConnectionColor, IReadOnlyList<AgentProblemCount> Reasons, MonitoredProgress? Current)
    {
        public AgentProblemCount? PrimaryReason => Reasons.FirstOrDefault(reason => reason.Code != "Offline" && !RepeatsLatestRun(reason));

        private bool RepeatsLatestRun(AgentProblemCount reason) => Entry.LatestRun is { } run && reason.Code switch
        {
            "Failed" or "Interrupted" or "Cancelled" => reason.Count == 1 && reason.Code == run.Status,
            "Partial" => reason.Count == 1 && run.Status == "PartiallySucceeded",
            "Warning" => reason.Count == 1 && run.Status == "Succeeded" && run.WarningCount > 0,
            _ => false
        };
        public string CurrentJob { get; set; } = "Копирование";
    }

    protected override async Task OnParametersSetAsync()
    {
        var token = Http.HttpContext!.RequestAborted;
        var entries = await Store.AgentTreeAsync(token);
        var problems = (await Store.TreeProblemSummariesAsync(Settings.OfflineAfterSeconds, token)).ToDictionary(problem => problem.AgentId);
        var cutoff = DateTimeOffset.UtcNow.AddSeconds(-Settings.OfflineAfterSeconds);
        var folderIds = Folders.Select(folder => folder.Id).ToHashSet();
        var rows = entries.Select(entry =>
        {
            var reasons = problems.GetValueOrDefault(entry.Id)?.Reasons.OrderBy(reason => ProblemText.Priority(reason.Code))
                .ThenBy(reason => reason.Code, StringComparer.Ordinal).ToArray() ?? [];
            var (connection, color) = entry.Revoked ? ("Доступ отозван", "dashboard-error")
                : entry.LastSeen is null ? ("Ожидает первого сигнала", "dashboard-warn")
                : entry.LastSeen < cutoff ? ("Нет связи", "dashboard-error")
                : ("На связи", "dashboard-good");
            var current = !entry.Revoked && entry.Observed >= cutoff && entry.Progress is { } progress
                && (entry.LatestRun is not { } latest || latest.JobId != progress.JobId || latest.FinishedUtc < progress.UpdatedUtc)
                ? progress : null;
            return new AgentRow(entry, connection, color, reasons, current) { CurrentJob = entry.ProgressJob ?? "Копирование" };
        }).ToLookup(row => row.Entry.FolderId is { } id && folderIds.Contains(id) ? id : Guid.Empty);
        var children = Folders.ToLookup(folder => folder.ParentId ?? Guid.Empty);
        BranchNode Build(AgentFolderOption folder) => new(folder.Id.ToString(), folder.Name, folder.Id,
            children[folder.Id].Select(Build).ToArray(), rows[folder.Id].ToArray(), folder.Path, folder.ParentId?.ToString() ?? "all");
        Branches = children[Guid.Empty].Select(Build)
            .Append(new("root", "Без папки", null, [], rows[Guid.Empty].ToArray(), "Без папки", "all")).ToArray();
        Rows = rows.SelectMany(group => group).OrderByDescending(row => row.Current is not null)
            .ThenByDescending(row => row.Reasons.Count != 0).ThenBy(row => row.Entry.Name, StringComparer.CurrentCultureIgnoreCase).ToArray();
        Selected = AgentId is { } selected ? Rows.FirstOrDefault(row => row.Entry.Id == selected) : null;
        Latest = Selected?.Entry.LatestRun;
        if (Selected is { } item) Recent = (await Store.RunsAsync(item.Entry.Id, 0, token, agentCopiesOnly: true)).Runs.Take(8).ToArray();
        HasCurrentJob = Selected is { } current && Latest is { } run
            && (await Store.MonitoringAsync(current.Entry.Id, token))?.Snapshot.Jobs.Any(job => job.JobId == run.JobId) == true;
    }

    private string FolderPath(AgentRow row) => Folders.FirstOrDefault(folder => folder.Id == row.Entry.FolderId)?.Path ?? "Без папки";

    private static string ProgressLabel(MonitoredProgress progress)
    {
        var stage = progress.Stage switch
        {
            "ConnectingSource" => "Подключение к источнику",
            "PreparingStorage" or "ConnectingStorage" => "Подключение к хранилищу",
            "CreatingBackup" or "ScanningSource" => "Создание копии",
            "Archiving" => "Архивация",
            "CopyingToStorage" => "Доставка",
            "Verifying" => "Проверка",
            _ => "Выполняется"
        };
        return progress.Percent is { } percent ? $"{stage} · {percent}%" : stage;
    }

    private static string ProblemColor(string code) => code switch
    {
        "Offline" or "Failed" or "PollFailed" or "AccessRequired" or "PlanRejected" or "ExecutorUnavailable" => "dashboard-error",
        _ => "dashboard-warn"
    };

    private static string DeliveryColor(MonitoredRun run) => run.Status switch
    {
        "Failed" or "Interrupted" => "dashboard-error",
        "Succeeded" when !run.Incomplete && run.WarningCount == 0 && run.Destinations.Any(destination => destination.Succeeded) => "dashboard-good",
        _ => "dashboard-warn"
    };

    private static string Delivery(MonitoredRun run)
    {
        var delivered = run.Destinations.Count(destination => destination.Succeeded);
        return run.Status switch
        {
            "Succeeded" when run.Incomplete => "Доставлено с пропусками",
            "Succeeded" when run.WarningCount > 0 && delivered > 0 => $"Доставлено с предупреждениями · {delivered}",
            "Succeeded" when delivered > 0 => $"Доставлено в хранилища: {delivered}",
            "PartiallySucceeded" => $"Частичная доставка · {delivered} из {run.Destinations.Count}",
            "Cancelled" => "Копирование отменено",
            "Interrupted" => "Копирование прервано",
            "Failed" => "Ошибка копирования",
            _ => "Доставка не подтверждена"
        };
    }
}
