<Window x:Class="SPBackup.Desktop.DestinationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Дополнительное хранилище" Width="620" Height="420" MinWidth="520" MinHeight="330"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="Куда отправлять ещё одну копию?" FontSize="20" FontWeight="SemiBold" />
   <TextBlock Text="База и архив создаются один раз. В это хранилище отправляется тот же файл." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" /></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Тип хранилища" /><ComboBox x:Name="Storage" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Storage_Changed" Margin="0,4,0,10" />
   <TextBlock x:Name="DestinationLabel" Text="Папка копий" /><DockPanel x:Name="DestinationPanel" Margin="0,4,0,10"><Button x:Name="BrowseButton" Content="Выбрать…" DockPanel.Dock="Right" Click="Browse_Click" Margin="6,0,0,0" /><TextBox x:Name="Destination" TextChanged="NetworkDestination_Changed" /></DockPanel>
   <TextBlock x:Name="PathHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
   <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Margin="0,0,0,10">
    <CheckBox x:Name="NetworkUseCredentials" Content="Отдельный логин и пароль NAS / сетевой папки" Checked="NetworkMode_Changed" Unchecked="NetworkMode_Changed" />
    <Button x:Name="NetworkCredentialsButton" Content="Задать сетевой логин и пароль…" Click="NetworkCredentials_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" />
    <TextBlock x:Name="NetworkCredentialStatus" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" />
   </StackPanel>
   <TextBlock Text="Хранить последних успешных копий" />
   <TextBox x:Name="KeepLast" Margin="0,4,0,4" ToolTip="Минимум 1. Пустое поле — количество из основного хранилища задания." />
   <TextBlock Text="Минимум 1. Пустое поле — как в основном хранилище задания."
    TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
   <StackPanel x:Name="GoogleDrivePanel" Visibility="Collapsed">
    <Button Content="Подключить Google Drive…" Click="GoogleDriveConnect_Click" HorizontalAlignment="Left"/>
    <TextBlock x:Name="GoogleDriveStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/>
   </StackPanel>
   <StackPanel x:Name="RemotePanel" Visibility="Collapsed"><Button Content="Импортировать подключение шлюза…" Click="RemoteImport_Click" HorizontalAlignment="Left"/><TextBlock x:Name="RemoteStatus" TextWrapping="Wrap" Margin="0,6,0,10"/><TextBlock Text="В основном задании нужно включить пароль архива. Папка копий задаётся в контейнере." TextWrapping="Wrap"/></StackPanel>
   <StackPanel x:Name="FtpPanel" Visibility="Collapsed">
    <TextBlock Text="FTP-сервер (без ftp://)" /><TextBox x:Name="FtpHost" Margin="0,4,0,10" />
    <TextBlock Text="Порт" /><TextBox x:Name="FtpPort" Text="21" Margin="0,4,0,10" />
    <CheckBox x:Name="FtpTls" Content="Защищённое соединение FTPS" IsChecked="True" Margin="0,0,0,10" />
    <Button Content="Настроить логин и пароль" Click="Credentials_Click" HorizontalAlignment="Left" />
    <TextBlock x:Name="CredentialsStatus" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}" />
   </StackPanel>
  </StackPanel></ScrollViewer>
  <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,8" />
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" /><Button x:Name="SaveButton" Content="Добавить хранилище" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" /></StackPanel>
 </Grid>
</Window>
