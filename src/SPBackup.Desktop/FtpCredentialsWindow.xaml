<Window x:Class="SPBackup.Desktop.FtpCredentialsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Учётные данные FTP" Width="470" Height="385" MinWidth="380" MinHeight="290"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="20" FocusManager.FocusedElement="{Binding ElementName=Username}">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="BindingName" TextWrapping="Wrap" Margin="0,0,0,12" />
   <TextBlock Text="Логин" /><TextBox x:Name="Username" AutomationProperties.Name="Логин" Margin="0,4,0,12" />
   <TextBlock Text="Пароль" /><PasswordBox x:Name="Password" AutomationProperties.Name="Пароль" Margin="0,4,0,12" />
   <CheckBox x:Name="EmptyPassword" Content="Использовать пустой пароль" Visibility="Collapsed" Margin="0,0,0,12" />
   <TextBlock x:Name="CredentialExplanation" Text="Доступ сохраняется в диспетчере учётных данных Windows." TextWrapping="Wrap" Margin="0,0,0,8" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
   <Button x:Name="CredentialSaveButton" Content="Сохранить учётные данные" IsDefault="True" Click="Save_Click" />
  </WrapPanel>
 </Grid>
</Window>
