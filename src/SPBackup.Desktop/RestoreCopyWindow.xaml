<Window x:Class="SPBackup.Desktop.RestoreCopyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Восстановление копии" Width="540" Height="430" MinWidth="420" MinHeight="340"
 WindowStartupLocation="CenterOwner">
 <Grid Margin="18" FocusManager.FocusedElement="{Binding ElementName=PickFolderButton}">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="CopyName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="CopySource" TextWrapping="Wrap" Margin="0,4,0,8" />
    <TextBlock x:Name="ChainStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
    <TextBlock Text="Папка назначения" Margin="0,12,0,4" />
    <DockPanel>
     <Button x:Name="PickFolderButton" DockPanel.Dock="Right" Content="Выбрать…" Click="PickFolder_Click" Margin="8,0,0,0" />
     <TextBox x:Name="TargetFolder" Text="Папка не выбрана" IsReadOnly="True" AutomationProperties.Name="Папка назначения" />
    </DockPanel>
    <TextBlock x:Name="FolderHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
    <TextBlock x:Name="PasswordHint" TextWrapping="Wrap" Margin="0,12,0,4" />
    <PasswordBox x:Name="OverridePassword" AutomationProperties.Name="Пароль архива для этой операции" />
   </StackPanel>
  </ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
   <Button x:Name="RestoreButton" Content="Восстановить" Style="{StaticResource PrimaryButton}" IsDefault="True"
    IsEnabled="False" Click="Restore_Click" />
  </WrapPanel>
 </Grid>
</Window>
