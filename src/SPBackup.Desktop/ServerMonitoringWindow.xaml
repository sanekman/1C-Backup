<Window x:Class="SPBackup.Desktop.ServerMonitoringWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подключить сервер" Width="570" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid Margin="24" FocusManager.FocusedElement="{Binding ElementName=Address}">
 <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Подключение к серверу" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Создайте приглашение в панели сервера и скопируйте данные подключения. Затем в настройках агента выберите: локальные задания или задания с сервера." TextWrapping="Wrap" Margin="0,12,0,16"/>
  <TextBlock Text="Адрес сервера (HTTPS)"/><TextBox x:Name="Address" Margin="0,5,0,12"/>
  <TextBlock Text="Код приглашения"/><PasswordBox x:Name="Invitation" Margin="0,5,0,12"/>
  <TextBlock Text="SHA-256 сертификата (из панели сервера)"/><TextBox x:Name="Fingerprint" Margin="0,5,0,12"/>
  <TextBlock Text="Для сервера с сертификатом доверенного центра поле SHA-256 можно оставить пустым. Сверяйте отпечаток через доверенный канал." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
  <Button x:Name="CancelConnection" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
  <Button x:Name="Connect" Content="Подключить" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
 </WrapPanel></Grid>
</Window>
