<Window x:Class="SPBackup.Desktop.ServerMonitoringWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подключить мониторинг" Width="570" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <StackPanel Margin="24">
  <TextBlock Text="Мониторинг на сервере" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Создайте приглашение в панели сервера и скопируйте три поля. Ваши задания и расписания продолжат работать локально." TextWrapping="Wrap" Margin="0,12,0,16"/>
  <TextBlock Text="Адрес сервера (HTTPS)"/><TextBox x:Name="Address" Margin="0,5,0,12"/>
  <TextBlock Text="Код приглашения"/><PasswordBox x:Name="Invitation" Margin="0,5,0,12"/>
  <TextBlock Text="SHA-256 сертификата (из панели сервера)"/><TextBox x:Name="Fingerprint" Margin="0,5,0,12"/>
  <TextBlock Text="Для сервера с сертификатом доверенного центра поле SHA-256 можно оставить пустым. Сверяйте отпечаток через доверенный канал." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Button x:Name="Connect" Content="Подключить" HorizontalAlignment="Left" Padding="18,8" Click="Connect_Click"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </StackPanel>
</Window>
