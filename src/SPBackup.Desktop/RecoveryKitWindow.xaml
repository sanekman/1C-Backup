<Window x:Class="SPBackup.Desktop.RecoveryKitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Восстановление из комплекта" Width="530" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="18">
  <TextBlock x:Name="PointInfo" TextWrapping="Wrap" FontWeight="SemiBold"/>
  <DockPanel Margin="0,12,0,8">
   <Button x:Name="PickFolder" DockPanel.Dock="Right" Content="Выбрать папку…" Margin="8,0,0,0" Click="Choose_Click"/>
   <TextBox x:Name="Destination" IsReadOnly="True" Text="Папка восстановления не выбрана"
    AutomationProperties.Name="Папка восстановления"/>
  </DockPanel>
  <StackPanel x:Name="PasswordFields">
   <TextBlock Text="Пароль архива" Margin="0,6,0,4"/>
   <PasswordBox x:Name="Password" AutomationProperties.Name="Пароль архива" MaxLength="1024"/>
  </StackPanel>
  <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="Restore" Content="Восстановить" IsDefault="True" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Restore_Click"/>
  </WrapPanel>
 </StackPanel>
</Window>
