<Window x:Class="SPBackup.Desktop.ArchivePasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Пароль архива" Width="490" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="20">
  <TextBlock x:Name="Instructions" TextWrapping="Wrap" Margin="0,0,0,12" />
  <TextBlock Text="Пароль" /><PasswordBox x:Name="Password" Margin="0,4,0,12" />
  <StackPanel x:Name="ConfirmationPanel">
   <TextBlock Text="Повторите пароль" /><PasswordBox x:Name="Confirmation" Margin="0,4,0,12" />
  </StackPanel>
  <TextBlock Text="ZIP AES-256 открывается в 7-Zip и WinRAR. Сохраните пароль отдельно: без него восстановить содержимое невозможно. Имена файлов внутри ZIP видны без пароля."
   TextWrapping="Wrap" Margin="0,0,0,12" />
  <Button x:Name="ApplyButton" Content="Сохранить новый пароль" HorizontalAlignment="Left" Padding="12,6" Click="Apply_Click" />
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
 </StackPanel>
</Window>
