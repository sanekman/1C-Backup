<Window x:Class="SPBackup.Desktop.ArchivePasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Пароль архива ZIP" Width="490" Height="410" MinWidth="385" MinHeight="295"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="20" FocusManager.FocusedElement="{Binding ElementName=Password}">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="Instructions" TextWrapping="Wrap" Margin="0,0,0,12" />
   <TextBlock Text="Пароль архива" /><PasswordBox x:Name="Password" AutomationProperties.Name="Пароль архива" Margin="0,4,0,12" />
   <StackPanel x:Name="ConfirmationPanel">
    <TextBlock Text="Повторите пароль" /><PasswordBox x:Name="Confirmation" AutomationProperties.Name="Повторите пароль" Margin="0,4,0,12" />
    <TextBlock Text="Сохраните пароль отдельно. Он нужен для восстановления. Имена файлов в ZIP видны без пароля."
     TextWrapping="Wrap" Margin="0,0,0,12" />
   </StackPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
   <Button x:Name="ApplyButton" Content="Сохранить новый пароль" IsDefault="True" Click="Apply_Click" />
  </WrapPanel>
 </Grid>
</Window>
