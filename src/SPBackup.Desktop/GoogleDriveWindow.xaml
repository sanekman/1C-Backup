<Window x:Class="SPBackup.Desktop.GoogleDriveWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Подключить Google Drive" Width="520" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Google Drive" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Войдите через браузер. Программа создаст папку «SP Backup» и получит доступ только к своим файлам. Пароль Google вводится только на сайте Google." TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{DynamicResource MutedBrush}"/>
   <Button x:Name="ImportButton" Content="1. Выбрать OAuth JSON…" Click="Import_Click" HorizontalAlignment="Left"/>
   <TextBlock x:Name="ClientStatus" Text="Нужен OAuth-клиент типа Desktop app из Google Cloud." TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{DynamicResource MutedBrush}"/>
   <Button x:Name="ConnectButton" Content="2. Войти в Google и создать папку" Click="Connect_Click" IsEnabled="False" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <TextBlock Text="Настройки подключения защищённо сохраняются в Windows. Фоновое копирование работает без открытого браузера. Проверка SHA-256 читает копию из облака и расходует входящий трафик." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
  </StackPanel></ScrollViewer>
  <Button Grid.Row="1" Content="Отмена" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
 </Grid>
</Window>
