<Window x:Class="SPBackup.Desktop.NotificationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Оповещения" Width="900" Height="580" MinWidth="650" MinHeight="450" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
   <TabItem x:Name="SettingsTab" Header="Каналы и события">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Результаты копирования в Telegram и MAX" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="«Тест из приложения» проверяет введённые данные. «Тест через агент» использует сохранённый канал и выполняется в фоне, в том числе под Windows-службой." TextWrapping="Wrap" Margin="0,6,0,10"/>
   <WrapPanel Margin="0,0,0,10"><CheckBox x:Name="Errors" Content="Ошибки" Margin="0,0,14,0"/><CheckBox x:Name="Warnings" Content="Предупреждения" Margin="0,0,14,0"/><CheckBox x:Name="Success" Content="Успешные копии" Margin="0,0,14,0"/><CheckBox x:Name="Cancelled" Content="Отмена"/></WrapPanel>
   <GroupBox Header="Telegram" Padding="10" Margin="0,0,0,10"><StackPanel>
    <CheckBox x:Name="TelegramEnabled" Content="Отправлять в Telegram"/>
    <TextBlock Text="Создайте бота через @BotFather и отправьте ему /start. Для группы добавьте бота в группу. Укажите числовой chat_id." TextWrapping="Wrap" Margin="0,6,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="Токен бота"/><PasswordBox x:Name="TelegramToken" Margin="0,4,0,0" ToolTip="Оставьте пустым, чтобы сохранить текущий токен."/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="ID чата (chat_id)"/><TextBox x:Name="TelegramRecipient" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0"><Button Content="Тест из приложения" Tag="Telegram" Click="Test_Click"/><Button Content="Тест через агент" Margin="8,0,0,0" Tag="Telegram" Click="TestInAgent_Click" ToolTip="Использует сохранённый канал и данные входа фонового процесса."/><Button Content="Как подключить" Margin="8,0,0,0" Tag="Telegram" Click="Help_Click"/></WrapPanel>
   </StackPanel></GroupBox>
   <GroupBox Header="MAX" Padding="10"><StackPanel>
    <CheckBox x:Name="MaxEnabled" Content="Отправлять в MAX"/>
    <TextBlock Text="Создайте бота на платформе MAX для партнёров. Получатель должен разрешить боту отправку сообщений. Укажите ID пользователя или чата." TextWrapping="Wrap" Margin="0,6,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="Токен бота"/><PasswordBox x:Name="MaxToken" Margin="0,4,0,0" ToolTip="Оставьте пустым, чтобы сохранить текущий токен."/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Получатель"/><ComboBox x:Name="MaxTarget" SelectedIndex="0" Margin="0,4,0,4"><ComboBoxItem Content="Чат или канал (chat_id)"/><ComboBoxItem Content="Пользователь (user_id)"/></ComboBox><TextBox x:Name="MaxRecipient"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0"><Button Content="Тест из приложения" Tag="Max" Click="Test_Click"/><Button Content="Тест через агент" Margin="8,0,0,0" Tag="Max" Click="TestInAgent_Click" ToolTip="Использует сохранённый канал и данные входа фонового процесса."/><Button Content="Как подключить" Margin="8,0,0,0" Tag="Max" Click="Help_Click"/></WrapPanel>
   </StackPanel></GroupBox>
   <TextBlock Text="Токены скрыты и сохраняются в защищённом хранилище Windows. Пустое поле сохраняет прежний токен. После включения отправляются только новые результаты. Сообщения содержат имя задания, компьютер, результат и время; пути и текст ошибок не отправляются." TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="QueueTab" Header="Очередь">
    <DockPanel Margin="10">
     <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button x:Name="RefreshQueue" Content="Обновить" Click="RefreshQueue_Click" Margin="0,0,8,0"/>
      <Button x:Name="RetryDelivery" Content="Повторить" IsEnabled="False" Click="RetryDelivery_Click" Margin="0,0,8,0"/>
      <Button x:Name="CancelDelivery" Content="Отменить доставку" IsEnabled="False" Click="CancelDelivery_Click"/>
     </WrapPanel>
     <TextBlock x:Name="QueueCount" DockPanel.Dock="Top" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,0,0,6"/>
     <TextBlock x:Name="QueueDetail" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <DataGrid x:Name="DeliveryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
       CanUserAddRows="False" SelectionChanged="DeliveryGrid_SelectionChanged" AutomationProperties.Name="Доставки оповещений">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Канал" Binding="{Binding Channel}" Width="100"/>
       <DataGridTextColumn Header="ID запуска" Binding="{Binding Run}" Width="90"/>
       <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*" MinWidth="148"/>
       <DataGridTextColumn Header="Попытки" Binding="{Binding Entry.Attempts}" Width="70"/>
       <DataGridTextColumn Header="Время состояния" Binding="{Binding Timestamp}" Width="148"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="1" x:Name="Result" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,8,0,8"/>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button x:Name="Save" Content="Сохранить каналы" Click="Save_Click"/><Button Content="Закрыть" IsCancel="True" Margin="8,0,0,0"/></WrapPanel>
 </Grid>
</Window>
