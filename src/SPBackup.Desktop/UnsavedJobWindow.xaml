<Window x:Class="SPBackup.Desktop.UnsavedJobWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Несохранённое задание" Width="560" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <StackPanel Margin="24">
  <TextBlock Text="Сохранить изменения задания?" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
  <TextBlock FontSize="16" Text="Если выйти без сохранения, введённые настройки будут потеряны. Сохранение задания не запускает копирование."
   TextWrapping="Wrap" Margin="0,12,0,20" />
  <WrapPanel>
   <Button x:Name="SaveDraftButton" Content="Сохранить" FontSize="14" Padding="14,10" IsDefault="True" Click="Save_Click" Margin="0,0,8,8" />
   <Button x:Name="DiscardDraftButton" Content="Не сохранять" FontSize="14" Padding="14,10" Click="Discard_Click" Margin="0,0,8,8" />
   <Button x:Name="ReturnToDraftButton" Content="Вернуться" FontSize="14" Padding="14,10" IsCancel="True" Margin="0,0,0,8" />
  </WrapPanel>
 </StackPanel>
</Window>
