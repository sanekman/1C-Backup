<Window x:Class="OneCBackup.Desktop.NotificationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Оповещения" Width="620" Height="570" MinWidth="500" MinHeight="450" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Результаты копирования в Telegram и MAX" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Отправка не мешает копированию. При отсутствии сети сообщения повторяются, пока работает программа или агент." TextWrapping="Wrap" Margin="0,6,0,10"/>
   <WrapPanel Margin="0,0,0,10"><CheckBox x:Name="Errors" Content="Ошибки" Margin="0,0,14,0"/><CheckBox x:Name="Warnings" Content="Предупреждения" Margin="0,0,14,0"/><CheckBox x:Name="Success" Content="Успешные копии" Margin="0,0,14,0"/><CheckBox x:Name="Cancelled" Content="Отмена"/></WrapPanel>
   <GroupBox Header="Telegram" Padding="10" Margin="0,0,0,10"><StackPanel>
    <CheckBox x:Name="TelegramEnabled" Content="Отправлять в Telegram"/>
    <TextBlock Text="Создайте бота через @BotFather и отправьте ему /start. Для группы добавьте бота в группу. Укажите числовой chat_id." TextWrapping="Wrap" Margin="0,6,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="Токен бота"/><PasswordBox x:Name="TelegramToken" Margin="0,4,0,0" ToolTip="Оставьте пустым, чтобы сохранить текущий токен."/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="ID чата (chat_id)"/><TextBox x:Name="TelegramRecipient" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0"><Button Content="Отправить тест" Tag="Telegram" Click="Test_Click"/><Button Content="Как подключить" Margin="8,0,0,0" Tag="Telegram" Click="Help_Click"/></WrapPanel>
   </StackPanel></GroupBox>
   <GroupBox Header="MAX" Padding="10"><StackPanel>
    <CheckBox x:Name="MaxEnabled" Content="Отправлять в MAX"/>
    <TextBlock Text="Создайте бота на платформе MAX для партнёров. Получатель должен разрешить боту отправку сообщений. Укажите ID пользователя или чата." TextWrapping="Wrap" Margin="0,6,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock Text="Токен бота"/><PasswordBox x:Name="MaxToken" Margin="0,4,0,0" ToolTip="Оставьте пустым, чтобы сохранить текущий токен."/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Получатель"/><ComboBox x:Name="MaxTarget" SelectedIndex="0" Margin="0,4,0,4"><ComboBoxItem Content="Чат или канал (chat_id)"/><ComboBoxItem Content="Пользователь (user_id)"/></ComboBox><TextBox x:Name="MaxRecipient"/></StackPanel>
    </Grid>
    <WrapPanel Margin="0,8,0,0"><Button Content="Отправить тест" Tag="Max" Click="Test_Click"/><Button Content="Как подключить" Margin="8,0,0,0" Tag="Max" Click="Help_Click"/></WrapPanel>
   </StackPanel></GroupBox>
   <TextBlock Text="Токены скрыты и сохраняются в защищённом хранилище Windows. Пустое поле сохраняет прежний токен. После включения отправляются только новые результаты. Сообщения содержат имя задания, компьютер, результат и время; пути и текст ошибок не отправляются." TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="1" x:Name="Result" TextWrapping="Wrap" Margin="0,8,0,8"/>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button x:Name="Save" Content="Сохранить" Click="Save_Click"/><Button Content="Закрыть" Click="Close_Click" Margin="8,0,0,0"/></WrapPanel>
 </Grid>
</Window>
