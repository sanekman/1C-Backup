<Window x:Class="OneCBackup.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:OneCBackup.Core;assembly=OneCBackup.Core"
 xmlns:local="clr-namespace:OneCBackup.Desktop"
 PreviewKeyDown="Window_PreviewKeyDown" Title="1C-Backup" Width="1100" Height="740" MinWidth="900" MinHeight="580"
 WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
 <Window.Resources>
  <local:LocalTimeConverter x:Key="LocalTimeConverter" />
  <local:JobRunOverviewConverter x:Key="JobRunOverviewConverter" />
  <DataTemplate x:Key="DatabaseKindLabel">
   <TextBlock>
    <TextBlock.Style><Style TargetType="TextBlock">
     <Setter Property="Text" Value="{Binding}" />
     <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.OneCFile}"><Setter Property="Text" Value="Файловая 1С" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.SqlServer}"><Setter Property="Text" Value="SQL Server" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.PostgreSql}"><Setter Property="Text" Value="PostgreSQL" /></DataTrigger>
     </Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
  </DataTemplate>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="#CBD5E1" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="Padding" Value="16,12" />
   <Setter Property="Margin" Value="0,0,0,6" />
   <Style.Triggers><Trigger Property="Tag" Value="Active">
    <Setter Property="Background" Value="#334155" /><Setter Property="Foreground" Value="White" />
   </Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#0F172A" Padding="12,20,12,16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,20">
     <TextBlock Text="1C-Backup" Foreground="White" FontSize="22" FontWeight="Bold" />
     <TextBlock Text="Резервное копирование" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
     <TextBlock x:Name="AppVersion" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,20,8,0">
     <TextBlock Text="Локальное приложение" Foreground="#CBD5E1" FontWeight="SemiBold" />
     <TextBlock Text="Расписание может работать после закрытия окна." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
    </StackPanel>
    <StackPanel>
     <Button x:Name="JobsNavigation" Content="Задания" Tag="Active" Style="{StaticResource NavigationButton}" Click="JobsNavigation_Click" />
     <Button x:Name="CopiesNavigation" Content="Резервные копии" Style="{StaticResource NavigationButton}" Click="CopiesNavigation_Click" />
     <Button x:Name="HistoryNavigation" Content="История запусков" Style="{StaticResource NavigationButton}" Click="HistoryNavigation_Click" />
     <Button x:Name="ExternalMonitoringButton" Content="Мониторинг SQL" Style="{StaticResource NavigationButton}" Click="ExternalMonitoring_Click" IsEnabled="False" ToolTip="Настройка источников и проверка внешних резервных копий SQL" />
     <Button x:Name="AgentNavigation" Content="Настройки" Style="{StaticResource NavigationButton}" Click="AgentNavigation_Click" />
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="18,12,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,8">
    <TextBlock x:Name="PageTitle" Text="Задания резервного копирования" FontSize="22" FontWeight="SemiBold" />
    <TextBlock x:Name="PageDescription" Text="Файловая 1С · Microsoft SQL Server · PostgreSQL" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
      <Button x:Name="StartBackgroundButton" Content="Включить автоматически" Style="{StaticResource PrimaryButton}" Click="StartBackground_Click" IsEnabled="False" ToolTip="Выполнять сохранённые задания по расписанию даже после закрытия окна" />
      <Button x:Name="StopBackgroundButton" Content="Остановить" Click="StopBackground_Click" IsEnabled="False" Visibility="Collapsed" />
     </StackPanel>
     <StackPanel><TextBlock Text="Автоматическое копирование" FontWeight="SemiBold" /><TextBlock x:Name="BackgroundStatus" Text="Проверка состояния…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
    </DockPanel>
   </Border>
   <Grid x:Name="JobsView" Grid.Row="2">
    <Border x:Name="JobListCard" Style="{StaticResource Card}">
     <DockPanel>
      <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button x:Name="JobScheduleButton" Content="Включить расписание" Click="ToggleJobSchedule_Click" IsEnabled="False" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" />
         <Button x:Name="NewJobButton" Content="+ Новое задание" Style="{StaticResource PrimaryButton}" Click="New_Click" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Мои задания" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="JobsSummary" Text="Загрузка…" Foreground="{StaticResource MutedBrush}" Margin="12,0,12,0" VerticalAlignment="Center" /></StackPanel>
       </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
       <StackPanel><WrapPanel>
        <Button x:Name="RunButton" Content="Создать копию" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Run_Click" />
        <Button x:Name="EditJobButton" Content="Изменить" Click="EditJob_Click" IsEnabled="False" Margin="8,0,0,0" />
        <Button x:Name="DuplicateJobButton" Content="На основе…" Click="DuplicateJob_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Создать новое задание с настройками выбранного. Автоматические запуски новой копии задания отключены до проверки." />
        <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click" IsEnabled="False" Margin="8,0,0,0" />
        <Button x:Name="CancelRunButton" Content="Отменить" Margin="8,0,0,0" IsEnabled="False" Click="CancelRun_Click" />
        <Button x:Name="ShowLatestCopyButton" Content="Последняя копия" Margin="8,0,0,0" IsEnabled="False" Click="ShowLatestCopy_Click" ToolTip="Открыть последнюю сохранённую копию выбранного задания" />
        <Button x:Name="ShowLatestRunButton" Content="Результат" Margin="8,0,0,0" IsEnabled="False" Click="ShowLatestRun_Click" ToolTip="Открыть последний запуск выбранного задания, включая ошибки и предупреждения" />
        <Button x:Name="CheckStorageButton" Content="Проверить хранилища" Margin="8,0,0,0" IsEnabled="False" Click="CheckStorage_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Проверить временную папку и запись, чтение и удаление тестового файла во всех хранилищах" />
        <Button x:Name="CancelStorageCheckButton" Content="Отменить проверку" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelCopyVerification_Click" />
       </WrapPanel>
       <ProgressBar x:Name="JobProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Создание резервной копии" />
       <TextBlock x:Name="SelectedJobSummary" Text="Выберите задание, чтобы создать копию или изменить настройки." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
       <Expander x:Name="StorageCheckResults" Header="Проверка хранилищ" Visibility="Collapsed" Margin="0,6,0,0">
        <TextBox x:Name="StorageCheckDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" />
       </Expander>
      </StackPanel></Border>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <DockPanel Margin="12,4"><TextBlock Text="Поиск" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBox x:Name="JobSearch" TextChanged="JobSearch_TextChanged" ToolTip="Поиск по названию задания или источнику" AutomationProperties.Name="Поиск по названию задания или источнику" />
       </DockPanel>
  <DataGrid Grid.Row="1" x:Name="Jobs" RowHeight="30" ColumnHeaderHeight="30" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
   SelectionChanged="Jobs_SelectionChanged" MouseDoubleClick="Jobs_DoubleClick" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="180" />
    <DataGridTemplateColumn Header="Тип" Width="100">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl Content="{Binding Kind}" ContentTemplate="{StaticResource DatabaseKindLabel}" />
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Расписание" Binding="{Binding ScheduleDescription}" Width="145">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding ScheduleDescription}" /></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="Последний запуск" Width="150">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl>
       <ContentControl.Content><MultiBinding Converter="{StaticResource JobRunOverviewConverter}">
        <Binding Path="Id" /><Binding Path="LatestJobRuns" RelativeSource="{RelativeSource AncestorType={x:Type local:MainWindow}}" />
       </MultiBinding></ContentControl.Content>
       <ContentControl.ContentTemplate><DataTemplate>
        <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontSize="12" TextTrimming="CharacterEllipsis">
         <TextBlock.ToolTip><ToolTip MaxWidth="520"><TextBlock Text="{Binding Help}" TextWrapping="Wrap" /></ToolTip></TextBlock.ToolTip>
        </TextBlock>
       </DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Авто" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBlock ToolTip="Разрешены запуски по расписанию. Для выполнения включите автоматическое копирование.">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Да" /><Style.Triggers>
       <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Text" Value="Нет" /></DataTrigger>
       <DataTrigger Binding="{Binding ScheduleKind}" Value="{x:Static core:ScheduleKind.Manual}"><Setter Property="Text" Value="Нет" /></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>

       <Border Grid.Row="1" Background="White" Margin="0,44,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
         <DataTrigger Binding="{Binding Items.Count, ElementName=Jobs}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
         <TextBlock x:Name="JobsEmptyTitle" Text="Добавьте первое задание" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
         <Button x:Name="FirstJobButton" Content="Создать первое задание" Click="New_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" />
         <TextBlock x:Name="JobsEmptyHint" Text="Укажите базу, хранилище и расписание.&#10;Сохранённое задание появится здесь." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
       </Border>
      </Grid>
     </DockPanel>
    </Border>
    <Border x:Name="EditorCard" Style="{StaticResource Card}" Visibility="Collapsed">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
       <StackPanel><TextBlock x:Name="EditorTitle" Text="Новое задание" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="WizardProgress" Text="1. База  →  2. Хранилище  →  3. Расписание  →  4. Проверка" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
       </StackPanel>
      </Border>
      <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="JobEditor" Margin="20,16" MaxWidth="700">
        <TextBlock x:Name="WizardHeading" Text="Что будем копировать?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="WizardHint" Text="Выберите базу и способ создания копии." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" />
        <StackPanel x:Name="BaseStep">
    <TextBlock x:Name="FileArchiveHint" Visibility="Collapsed" Text="Копируется файл базы в ZIP. Перед запуском закройте эту базу у всех пользователей 1С."
     TextWrapping="Wrap" Margin="0,0,0,12" Background="#FFFBEB" Foreground="#92400E" Padding="8" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Название" /><TextBox x:Name="JobName" Margin="0,4,0,10" /></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Тип базы" /><ComboBox x:Name="Kind" Margin="0,4,0,10" ItemTemplate="{StaticResource DatabaseKindLabel}" SelectionChanged="Kind_Changed" /></StackPanel>
   </Grid>
   <TextBlock x:Name="SourceLabel" Text="Папка базы 1С" TextWrapping="Wrap" /><DockPanel Margin="0,4,0,10">
    <Button x:Name="SourceBrowseButton" DockPanel.Dock="Right" Content="Выбрать…" Tag="Source" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="Source" />
   </DockPanel>
   <TextBlock x:Name="OneCSourceHelp" Text="Путь к базе можно посмотреть в окне запуска 1С: выделите базу и нажмите «Изменить»." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
   <StackPanel x:Name="OneCMethodPanel">
    <TextBlock Text="Способ резервного копирования 1С" />
    <ComboBox x:Name="OneCMethodPicker" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="OneCMethod_Changed" Margin="0,4,0,10" />

   </StackPanel>
   <StackPanel x:Name="OneCPanel">
    <TextBlock Text="Программа 1С (1cv8.exe)" /><DockPanel Margin="0,4,0,10">
    <Button DockPanel.Dock="Right" Content="…" Tag="OneCExecutable" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="OneCExecutable" />
   </DockPanel>
    <Expander Header="Дополнительно: ограничение времени" Margin="0,0,0,10"><StackPanel><TextBlock Text="Ограничение времени выгрузки, минут" /><TextBox x:Name="OneCTimeout" Text="120" Margin="0,4,0,10" /></StackPanel></Expander>
    <TextBlock Text="Выгрузка .dt требует эксклюзивного доступа. В этой версии поддерживаются базы без пароля пользователя 1С."
     TextWrapping="Wrap" Margin="0,0,0,10" />
   </StackPanel>
   <StackPanel x:Name="SqlBackupPanel" Visibility="Collapsed">
    <TextBlock Text="SQL Server (Windows-аутентификация)" /><TextBox x:Name="SqlBackupServer" Margin="0,4,0,10" />
    <TextBlock Text="Папка копий на SQL-сервере" TextWrapping="Wrap" /><TextBox x:Name="SqlServerDirectory" Margin="0,4,0,10" />
    <TextBlock Text="Эта папка со стороны вашего компьютера" TextWrapping="Wrap" /><DockPanel Margin="0,4,0,10">
    <Button DockPanel.Dock="Right" Content="…" Tag="SqlAgentDirectory" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="SqlAgentDirectory" />
   </DockPanel>
    <Expander Header="Дополнительно: ограничение времени" Margin="0,0,0,10"><StackPanel><TextBlock Text="Ограничение времени, минут" /><TextBox x:Name="SqlBackupTimeout" Text="120" Margin="0,4,0,10" /></StackPanel></Expander>
    <TextBlock Text="SQL-сервер создаёт файл .bak. Укажите путь, по которому этот компьютер сможет прочитать его, например \\server\backups."
     TextWrapping="Wrap" Margin="0,0,0,10" />
   </StackPanel>
   <StackPanel x:Name="PostgresBackupPanel" Visibility="Collapsed">
    <TextBlock Text="Сервер PostgreSQL" /><TextBox x:Name="PgHost" Text="localhost" Margin="0,4,0,10" />
    <TextBlock Text="Порт" /><TextBox x:Name="PgPort" Text="5432" Margin="0,4,0,10" />
    <TextBlock Text="Пользователь" /><TextBox x:Name="PgUsername" Text="postgres" Margin="0,4,0,10" />
    <TextBlock Text="Полный путь к pg_dump" /><DockPanel Margin="0,4,0,10">
    <Button DockPanel.Dock="Right" Content="…" Tag="PgDumpPath" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="PgDumpPath" />
   </DockPanel>
    <TextBlock Text="Полный путь к pg_restore" /><DockPanel Margin="0,4,0,10">
    <Button DockPanel.Dock="Right" Content="…" Tag="PgRestorePath" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="PgRestorePath" />
   </DockPanel>
    <Expander Header="Дополнительно: ограничение времени" Margin="0,0,0,10"><StackPanel><TextBlock Text="Ограничение времени, минут" /><TextBox x:Name="PgTimeout" Text="120" Margin="0,4,0,10" /></StackPanel></Expander>
    <TextBlock Text="Пароль задаётся через файл паролей PostgreSQL текущего пользователя. Запрос пароля отключён. Создаётся custom-дамп с проверкой каталога через pg_restore."
     TextWrapping="Wrap" Margin="0,0,0,10" />
   </StackPanel>
</StackPanel>
        <StackPanel x:Name="StorageStep" Visibility="Collapsed">   <TextBlock Text="Хранилище" /><ComboBox x:Name="Storage" Margin="0,4,0,10" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Storage_SelectionChanged" />
   <TextBlock Text="Каталог копий" /><DockPanel Margin="0,4,0,10">
    <Button x:Name="DestinationBrowseButton" DockPanel.Dock="Right" Content="Выбрать…" Tag="Destination" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="Destination" />
   </DockPanel>
   <TextBlock Text="Копии лучше хранить на другом диске или компьютере, отдельно от базы." TextWrapping="Wrap" Margin="0,0,0,10" />
   <StackPanel x:Name="FtpPanel" Visibility="Collapsed">
    <TextBlock Text="FTP-сервер (без ftp://)" /><TextBox x:Name="FtpHost" Margin="0,4,0,10" />
    <TextBlock Text="Порт" /><TextBox x:Name="FtpPort" Text="21" Margin="0,4,0,10" />
    <CheckBox x:Name="FtpTls" Content="Защищённое соединение FTPS" IsChecked="True" Margin="0,0,0,10" />
    <Expander Header="Дополнительно: сохранённые учётные данные"><StackPanel><TextBlock Text="Идентификатор записи Windows" /><TextBox x:Name="FtpCredentialKey" Margin="0,4,0,10" /></StackPanel></Expander>
    <Button x:Name="FtpCredentialsButton" Content="Настроить логин и пароль" HorizontalAlignment="Left" Padding="12,6" Click="FtpCredentials_Click" IsEnabled="False" Margin="0,0,0,10" />
    <TextBlock Text="Пароль хранится в Windows. Защищённое соединение FTPS проверяет сертификат сервера."
     TextWrapping="Wrap" Margin="0,0,0,10" />
   </StackPanel>
   <Expander x:Name="AdditionalStorageOptions" Header="Копировать также в другие хранилища (0)" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
    <TextBlock Text="Один готовый файл отправляется во все хранилища — до трёх одновременно. Для каждого можно задать своё количество копий; ошибка доставки не останавливает остальные." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
    <ListBox x:Name="AdditionalStorageList" DisplayMemberPath="Description" MaxHeight="120" Margin="0,0,0,8" SelectionChanged="AdditionalStorage_Changed" />
    <WrapPanel><Button x:Name="AddStorageButton" Content="+ Добавить хранилище" Click="AddStorage_Click" /><Button x:Name="EditStorageButton" Content="Изменить" Click="EditStorage_Click" IsEnabled="False" Margin="8,0,0,0" /><Button x:Name="RemoveStorageButton" Content="Убрать" Click="RemoveStorage_Click" IsEnabled="False" Margin="8,0,0,0" /></WrapPanel>
    <TextBlock Text="Изменения вступят в силу после сохранения задания. Удаление хранилища из списка не удаляет сохранённые файлы." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
   </StackPanel></Expander>
   <TextBlock Text="Временная папка — где формировать копию" Margin="0,12,0,0" />
   <DockPanel Margin="0,4,0,6">
    <Button Content="Выбрать…" Tag="TemporaryFolder" Click="BrowsePath_Click" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,6" />
    <TextBox x:Name="TemporaryFolder" ToolTip="Оставьте пустым для использования стандартной рабочей папки приложения." />
   </DockPanel>
   <TextBlock Text="Выберите HDD для выгрузки, ZIP и проверки FTP. Пустое поле — стандартная папка приложения. После успеха временные файлы удаляются; при ошибке остаются."
    TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
   <TextBlock x:Name="SqlTemporaryHint" Text="Исходный .bak создаётся в «Каталоге на SQL-сервере» — выберите HDD также там. ZIP формируется во временной папке агента."
    Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
<Expander x:Name="ArchiveOptions" Header="Архивация и пароль" Margin="0,8,0,0"><StackPanel Margin="0,10,0,0">   <CheckBox x:Name="ArchiveCopies" Content="Архивировать копии в ZIP" Margin="0,0,0,8" />
   <CheckBox x:Name="EncryptArchive" Content="Шифровать ZIP паролем (AES-256)" Margin="0,0,0,8" Checked="Encryption_Changed" Unchecked="Encryption_Changed" />
   <Button x:Name="ArchivePasswordButton" Content="Задать новый пароль архива" HorizontalAlignment="Left" Padding="12,6" Click="ArchivePassword_Click" Margin="0,0,0,6" />
   <TextBlock x:Name="ArchivePasswordStatus" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12" />
</StackPanel></Expander></StackPanel>
        <StackPanel x:Name="ScheduleStep" Visibility="Collapsed">   <TextBlock Text="Расписание" /><ComboBox x:Name="Schedule" Margin="0,4,0,10" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Schedule_Changed" />
   <WrapPanel x:Name="DaysPanel" Visibility="Collapsed" Margin="0,0,0,10">
    <CheckBox x:Name="Mon" Content="Пн" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Tue" Content="Вт" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Wed" Content="Ср" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Thu" Content="Чт" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Fri" Content="Пт" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Sat" Content="Сб" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
    <CheckBox x:Name="Sun" Content="Вс" Margin="0,0,10,4" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />
   </WrapPanel>
   <StackPanel x:Name="TimePanel">
    <TextBlock Text="Время запуска" /><TextBox x:Name="DailyAt" Text="23:00" Margin="0,4,0,4" TextChanged="Schedule_Changed" />
    <TextBlock Text="Можно несколько раз в день: 09:00, 13:00, 23:00." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" />
   </StackPanel>
   <StackPanel x:Name="ZonePanel"><TextBlock Text="Часовой пояс" /><ComboBox x:Name="TimeZonePicker" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="TimeZone_Changed" Margin="0,4,0,10" /></StackPanel>
   <StackPanel x:Name="SchedulePreviewPanel">
   <TextBlock x:Name="NextRun" TextWrapping="Wrap" Margin="0,0,0,10" />
   <TextBlock x:Name="SchedulePreviewHint" Text="Это плановое время. Для выполнения должен работать планировщик, компьютер должен быть включён."
    Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" />
   </StackPanel>
   <Expander x:Name="TechnicalZoneOptions" Header="Технический идентификатор часового пояса" Margin="0,0,0,8"><TextBox x:Name="Zone" TextChanged="Schedule_Changed" /></Expander>
   <TextBlock Text="Хранить последних успешных копий в основном хранилище" /><TextBox x:Name="KeepLast" Text="7" Margin="0,4,0,4" />
   <TextBlock Text="Дополнительные хранилища используют это число, если в их настройках не задано своё." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10" />
   <CheckBox x:Name="Enabled" Content="Выполнять задание по расписанию" IsChecked="True" Margin="0,0,0,12" Checked="Schedule_Changed" Unchecked="Schedule_Changed" />

<TextBlock Text="Старые копии удаляются только после создания и проверки новой. 7 копий при одном запуске в день — примерно неделя истории. Компьютер должен быть включён; для фоновых запусков нужен вход пользователя в Windows." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
</StackPanel>
        <StackPanel x:Name="ReviewStep" Visibility="Collapsed">
         <TextBox x:Name="WizardSummary" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="#F8FAFC" Padding="14" />
         <TextBlock Text="После сохранения создайте первую копию вручную. Для автоматических запусков включите фоновую работу в верхней панели." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
       <StackPanel>
        <TextBlock x:Name="WizardError" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
        <DockPanel>
         <Button x:Name="CancelEditorButton" DockPanel.Dock="Left" Content="Отмена" Click="CancelEditor_Click" />
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PreviousStepButton" Content="Назад" Click="PreviousStep_Click" Margin="0,0,8,0" />
          <Button x:Name="NextStepButton" Content="Далее →" Style="{StaticResource PrimaryButton}" Click="NextStep_Click" />
          <Button x:Name="SaveButton" Content="Сохранить задание" Style="{StaticResource PrimaryButton}" Click="Save_Click" Visibility="Collapsed" />
         </StackPanel>
        </DockPanel>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <Border x:Name="HistoryView" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed" SizeChanged="HistoryView_SizeChanged">
   <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <DockPanel>
       <Button x:Name="ExportHistoryButton" DockPanel.Dock="Right" Content="Экспорт JSON" Click="ExportHistory_Click" IsEnabled="False" Margin="8,0,0,0" />
       <Button x:Name="RefreshHistoryButton" DockPanel.Dock="Right" Content="Обновить" Click="RefreshHistory_Click" IsEnabled="False" Margin="8,0,0,0" />
       <ComboBox x:Name="HistoryStatusFilter" DockPanel.Dock="Right" Width="160" SelectionChanged="HistoryFilter_Changed" Margin="8,0,0,0" SelectedIndex="0">
        <ComboBoxItem Content="Все результаты" Tag="all" />
        <ComboBoxItem Content="Ошибки / прерывания" Tag="problems" />
        <ComboBoxItem Content="Успешные" Tag="succeeded" />
        <ComboBoxItem Content="Выполняются" Tag="running" />
       </ComboBox>
       <TextBox x:Name="HistorySearch" TextChanged="HistorySearch_Changed" ToolTip="Поиск по заданию, пути или тексту ошибки" AutomationProperties.Name="Поиск в истории" />
      </DockPanel>
      <TextBlock x:Name="HistorySummary" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
     </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
     <StackPanel>
      <DockPanel Margin="0,0,0,8">
       <Button x:Name="OpenRunDirectoryButton" DockPanel.Dock="Right" Content="Рабочая папка" Click="OpenRunDirectory_Click" IsEnabled="False" Padding="10,5" />
       <Button x:Name="OpenHistoryJobButton" DockPanel.Dock="Right" Content="К заданию" Click="OpenHistoryJob_Click" IsEnabled="False" Padding="10,5" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" />
       <TextBlock Text="Подробности выбранного запуска" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="RunNextStep" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />
      <TextBox x:Name="RunDetails" Text="Выберите запуск в таблице." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" />
     </StackPanel>
    </Border>
   <DataGrid x:Name="RunHistory" RowHeight="30" ColumnHeaderHeight="30" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="RunHistory_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Начало" Binding="{Binding StartedUtc, Converter={StaticResource LocalTimeConverter}}" Width="145" />
     <DataGridTextColumn Header="Задание" Binding="{Binding JobName}" Width="170" />
     <DataGridTextColumn Header="Результат" Binding="{Binding StatusDescription}" Width="115" />
     <DataGridTextColumn Header="Копия / ошибка" Binding="{Binding Details}" Width="*" MinWidth="160" />
     <DataGridTextColumn Header="Рабочий каталог" Binding="{Binding WorkDirectory}" Visibility="Collapsed" />
    </DataGrid.Columns>
   </DataGrid>
   </DockPanel>
   </Border>
   <Border x:Name="CopiesView" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed" SizeChanged="CopiesView_SizeChanged">
    <DockPanel>
     <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <StackPanel><DockPanel>
       <Button x:Name="RefreshCopiesButton" Content="Обновить" DockPanel.Dock="Right" Click="RefreshCopies_Click" IsEnabled="False" />
       <TextBlock x:Name="CopiesSummary" Text="Загрузка списка…" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
      </DockPanel>
      <Grid Margin="0,6,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="Задание" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="CopyJobFilter" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="CopyFilter_Changed" AutomationProperties.Name="Фильтр копий по заданию" /></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Хранилище" Foreground="{StaticResource MutedBrush}" /><ComboBox x:Name="CopyStorageFilter" SelectedIndex="0" SelectionChanged="CopyFilter_Changed" AutomationProperties.Name="Фильтр копий по типу хранилища">
        <ComboBoxItem Content="Все хранилища" Tag="" /><ComboBoxItem Content="Локальный диск" Tag="local" /><ComboBoxItem Content="Сетевая папка" Tag="network" /><ComboBoxItem Content="FTP / FTPS" Tag="ftp" />
       </ComboBox></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Поиск по имени или пути" Foreground="{StaticResource MutedBrush}" /><TextBox x:Name="CopySearch" TextChanged="CopyFilter_Changed" AutomationProperties.Name="Поиск копий по имени задания или пути" /></StackPanel>
       <Button Grid.Column="3" x:Name="ResetCopyFiltersButton" Content="Сбросить" VerticalAlignment="Bottom" Click="ResetCopyFilters_Click" ToolTip="Показать копии всех заданий и хранилищ" />
      </Grid></StackPanel>
     </Border>
     <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
      <StackPanel>
       <WrapPanel>
        <Button x:Name="VerifyCopyButton" Content="Проверить целостность" Style="{StaticResource PrimaryButton}" Click="VerifyCopy_Click" IsEnabled="False" Margin="0,0,8,8" />
        <Button x:Name="ExtractOneCButton" Content="Извлечь 1Cv8.1CD" Click="ExtractOneC_Click" IsEnabled="False" Margin="0,0,8,8" ToolTip="Извлечь файловую базу из проверенного ZIP в новую папку. Доступно для локальных и сетевых копий." />
        <Button x:Name="CancelCopyVerificationButton" Content="Отменить операцию" Click="CancelCopyVerification_Click" IsEnabled="False" Margin="0,0,8,8" />
        <Button x:Name="OpenCopyDirectoryButton" Content="Открыть папку" Click="OpenCopyDirectory_Click" IsEnabled="False" Margin="0,0,0,8" />
       </WrapPanel>
       <TextBlock x:Name="CopyVerificationStatus" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <Expander x:Name="CopyDetailsPanel" Header="Подробности копии и проверки" Margin="0,4,0,0">
        <ScrollViewer x:Name="CopyDetailsScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,6,4,0">
       <TextBlock Text="{Binding Text, ElementName=CopyVerificationStatus}" TextWrapping="Wrap" />
       <TextBox x:Name="CopyDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" Background="Transparent" Margin="0,6,0,0" />
       <TextBlock Text="Список из журнала успешных копий. Наличие файлов проверяется кнопкой «Проверить целостность». Для проверки остановите планировщик. FTP-копия скачивается полностью; нужны свободное место и доступ к серверу." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </StackPanel></ScrollViewer>
       </Expander>
      </StackPanel>
     </Border>
     <DataGrid x:Name="Copies" RowHeight="30" ColumnHeaderHeight="30" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Copies_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Создана" Binding="{Binding CompletedUtc, Converter={StaticResource LocalTimeConverter}}" Width="140" />
       <DataGridTextColumn Header="Задание" Binding="{Binding JobName}" Width="150" />
       <DataGridTextColumn Header="Хранилище" Binding="{Binding StorageDescription}" Width="120" />
       <DataGridTextColumn Header="Размер" Binding="{Binding SizeDescription}" Width="85" />
       <DataGridTextColumn Header="Расположение" Binding="{Binding Location}" Width="*" MinWidth="180" />
       <DataGridTextColumn Header="Защита" Binding="{Binding EncryptionDescription}" Width="100" />
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <ScrollViewer x:Name="AgentView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource Card}" MaxWidth="700" HorizontalAlignment="Left">
   <StackPanel Margin="24">
    <StackPanel Margin="0,0,0,18">
     <TextBlock Text="О программе" FontSize="18" FontWeight="SemiBold" />
     <TextBox x:Name="BuildInfo" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,10" AutomationProperties.Name="Версия и сведения о сборке" />
     <Button x:Name="CopyBuildInfoButton" Content="Скопировать сведения" HorizontalAlignment="Left" Click="CopyBuildInfo_Click" />
     <TextBlock Text="Только версия, сборка и система. Настройки баз и пароли не копируются." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
     <TextBlock x:Name="BuildInfoStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <Border>
     <StackPanel>
      <TextBlock Text="Фоновая работа" FontSize="18" FontWeight="SemiBold" />
      <CheckBox x:Name="AgentStartup" Content="Запускать фоновый агент при входе в Windows" Margin="0,12,0,12" />
      <Button x:Name="SaveStartupButton" Content="Сохранить автозапуск" HorizontalAlignment="Left" Click="SaveStartup_Click" IsEnabled="False" />
      <TextBlock x:Name="StartupStatus" Text="Запуск от имени текущего пользователя. После переноса папки программы сохраните автозапуск заново. Это не служба Windows: работа без входа пользователя пока не поддерживается." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
     </StackPanel>
    </Border>

<Expander Header="Дополнительно: расписание только при открытом окне" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0">
 <TextBlock Text="Используйте этот режим вместо фонового агента, если копирование должно идти только пока открыта программа." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
 <WrapPanel Margin="0,10,0,0"><Button x:Name="StartScheduleButton" Content="Запустить в окне" Click="StartSchedule_Click" IsEnabled="False" /><Button x:Name="StopScheduleButton" Content="Остановить" Margin="8,0,0,0" Click="StopSchedule_Click" IsEnabled="False" /></WrapPanel>
 <TextBlock x:Name="SchedulerStatus" Text="Расписание в окне выключено." TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Expander>
    <Expander Header="Подключение к серверу управления" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock x:Name="AgentIdentity" Margin="0,0,0,8" />
    <ComboBox x:Name="AgentModePicker" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Value" SelectedValuePath="Key"
     SelectionChanged="AgentMode_Changed" Margin="0,0,0,8" />
    <StackPanel x:Name="ServerPanel" Visibility="Collapsed">
     <TextBlock Text="Адрес сервера управления (HTTPS, например https://backup.example.com/)" />
     <TextBox x:Name="ServerAddress" Margin="0,4,0,8" />
     <TextBlock Text="Идентификатор учётных данных агента (без токена или пароля)" />
     <TextBox x:Name="AgentCredentialKey" Margin="0,4,0,8" />
     <TextBlock Text="Интервал связи с сервером, секунд" /><TextBox x:Name="SyncInterval" Text="60" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8" />
    </StackPanel>
    <Button x:Name="SaveAgentSettingsButton" Content="Сохранить режим агента" HorizontalAlignment="Left" Padding="12,6" Click="SaveAgentSettings_Click" IsEnabled="False" />
    <TextBlock Text="Сервер управления ещё разрабатывается. Для локального копирования подключение к нему не требуется."
     TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel></Expander>

   </StackPanel>

    </Border>
   </ScrollViewer>
   <Border Grid.Row="3" Background="#E8EEF5" CornerRadius="6" Padding="8" Margin="0,10,0,0">
    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Status" Text="Загрузка настроек…" TextWrapping="Wrap" Foreground="#475569" /></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
