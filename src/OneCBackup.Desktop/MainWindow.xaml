       <TextBlock Text="{Binding Text, ElementName=CopyVerificationStatus}" TextWrapping="Wrap" />
       <TextBox x:Name="CopyDetails" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" Background="Transparent" Margin="0,6,0,0" />
       <TextBlock Text="Список из журнала успешных копий. Последняя проверка сохраняется отдельно и показывает результат на указанное время. Наличие файлов сейчас проверяется кнопкой «Проверить целостность». Для проверки остановите планировщик. FTP-копия скачивается полностью; нужны свободное место и доступ к серверу." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </StackPanel></ScrollViewer>
       </Expander>
      </StackPanel>
     </Border>
     <DataGrid x:Name="Copies" RowHeight="30" ColumnHeaderHeight="30" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Copies_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Создана" Binding="{Binding CompletedUtc, Converter={StaticResource LocalTimeConverter}}" Width="140" />
       <DataGridTemplateColumn Header="Задание" Width="*" MinWidth="125" SortMemberPath="JobName"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding JobName}" ToolTip="{Binding JobName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Хранилище" Width="110" SortMemberPath="StorageCategory"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CompactStorage}" ToolTip="{Binding StorageHelp}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Защита" Binding="{Binding EncryptionDescription}" Width="100" />
       <DataGridTemplateColumn Header="Последняя проверка" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CheckSummary}" Foreground="{Binding CheckColor, Converter={StaticResource ThemeColorConverter}}" ToolTip="{Binding CheckHelp}" FontSize="12" VerticalAlignment="Center" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <ScrollViewer x:Name="AgentView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource Card}" MaxWidth="700" HorizontalAlignment="Left">
   <StackPanel Margin="24">
    <Button Content="Выйти полностью — остановить агент и закрыть окно" Click="ExitFully_Click" HorizontalAlignment="Left" Margin="0,0,0,14" />
    <TextBlock Text="Оформление" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="По умолчанию тема следует настройкам Windows." Margin="0,6,0,4" Foreground="{DynamicResource MutedBrush}" />
    <ComboBox x:Name="ThemePicker" SelectedValuePath="Tag" SelectionChanged="Theme_Changed" Margin="0,0,0,18" AutomationProperties.Name="Тема оформления">
     <ComboBoxItem Content="Как в системе" Tag="System" /><ComboBoxItem Content="Светлая" Tag="Light" /><ComboBoxItem Content="Тёмная" Tag="Dark" />
    </ComboBox>
    <StackPanel Margin="0,0,0,18">
     <TextBlock Text="О программе" FontSize="18" FontWeight="SemiBold" />
     <TextBox x:Name="BuildInfo" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,10" AutomationProperties.Name="Версия и сведения о сборке" />
     <Button x:Name="CopyBuildInfoButton" Content="Скопировать сведения" HorizontalAlignment="Left" Click="CopyBuildInfo_Click" />
     <TextBlock Text="Только версия, сборка и система. Настройки баз и пароли не копируются." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
     <TextBlock x:Name="BuildInfoStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <StackPanel Margin="0,0,0,18">
     <TextBlock Text="Обновления" FontSize="18" FontWeight="SemiBold" />
     <CheckBox x:Name="AutomaticUpdateChecks" Content="Проверять новые версии автоматически" IsChecked="True" Click="UpdatePreference_Click" Margin="0,10,0,6" />
     <CheckBox x:Name="UpdateOnExit" Content="Обновлять при полном выходе из программы" Click="UpdatePreference_Click" Margin="0,0,0,6" />
     <CheckBox x:Name="IncludePreviewUpdates" Content="Получать предварительные версии" IsChecked="True" Click="UpdatePreference_Click" Margin="0,0,0,10" />
     <TextBlock Text="Автообновление скачивает новую версию и устанавливает её при «Выйти полностью», после остановки агента. Задания и копии сохраняются." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,10" />
     <WrapPanel><Button x:Name="CheckUpdatesButton" IsEnabled="False" Content="Проверить обновления" Click="CheckUpdates_Click" Margin="0,0,8,6" />
      <Button x:Name="InstallUpdateButton" Content="Обновить и перезапустить" Click="InstallUpdate_Click" IsEnabled="False" Margin="0,0,8,6" />
      <Button x:Name="UpdateReleaseButton" Content="Страница версии" Click="OpenUpdateRelease_Click" IsEnabled="False" Margin="0,0,8,6" />
      <Button x:Name="CancelUpdateButton" Content="Отменить" Click="CancelUpdate_Click" Visibility="Collapsed" Margin="0,0,0,6" /></WrapPanel>
     <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,4,0,8" />
     <TextBlock x:Name="UpdateResultStatus" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
     <TextBlock x:Name="UpdateStatus" Text="Обновления ещё не проверялись." TextWrapping="Wrap" Margin="0,0,0,6" />
     <Expander x:Name="UpdateAccessPanel" Header="Доступ к закрытому репозиторию GitHub" IsEnabled="False"><StackPanel Margin="0,8,0,0">
      <TextBlock Text="Для sanekman/1C-Backup нужен GitHub-токен с доступом к репозиторию и правом Contents: Read. Он хранится в диспетчере учётных данных Windows." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      <Button Content="Создать токен на GitHub" Click="CreateUpdateToken_Click" HorizontalAlignment="Left" Margin="0,8,0,4" />
      <TextBlock Text="Выберите репозиторий sanekman/1C-Backup и разрешение Contents: Read." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      <PasswordBox x:Name="GitHubUpdateToken" Margin="0,8,0,8" MaxLength="1024" AutomationProperties.Name="Токен GitHub для обновлений" />
      <WrapPanel><Button Content="Сохранить токен" Click="SaveUpdateToken_Click" Margin="0,0,8,6" /><Button Content="Удалить токен" Click="DeleteUpdateToken_Click" Margin="0,0,0,6" /></WrapPanel>
      <TextBlock x:Name="UpdateTokenStatus" Text="Токен не сохранён." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
     </StackPanel></Expander>
    </StackPanel>
    <StackPanel Margin="0,0,0,18">
     <TextBlock Text="Диагностика" FontSize="18" FontWeight="SemiBold" />
     <TextBlock Text="Возникла проблема? Сохраните ZIP и отправьте его для анализа вместе с примерным временем ошибки." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,10" />
     <WrapPanel><Button x:Name="ExportDiagnosticsButton" Content="Сохранить диагностику…" Click="ExportDiagnostics_Click" Margin="0,0,8,6" />
      <Button x:Name="OpenLogsButton" Content="Открыть папку логов" Click="OpenLogs_Click" Margin="0,0,0,6" /></WrapPanel>
     <TextBlock Text="Логи окна и агента: до 14 дней и 50 МБ. В ZIP нет паролей, настроек подключения, исходных файлов и копий. Отправка выполняется вами вручную." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
     <TextBlock x:Name="DiagnosticsStatus" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <Border>
     <StackPanel>
      <TextBlock Text="Фоновая работа" FontSize="18" FontWeight="SemiBold" />
      <CheckBox x:Name="AgentStartup" Content="Запускать агент со значком в трее при входе в Windows" Margin="0,12,0,12" />
      <Button x:Name="SaveStartupButton" Content="Сохранить автозапуск" HorizontalAlignment="Left" Click="SaveStartup_Click" IsEnabled="False" />
      <TextBlock x:Name="StartupStatus" Text="Запуск от имени текущего пользователя. После переноса папки программы сохраните автозапуск заново. Это не служба Windows: работа без входа пользователя пока не поддерживается." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" />
     </StackPanel>
    </Border>

<Expander Header="Дополнительно: расписание только при открытом окне" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0">
 <TextBlock Text="Используйте этот режим вместо фонового агента, если копирование должно идти только пока открыта программа." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
 <WrapPanel Margin="0,10,0,0"><Button x:Name="StartScheduleButton" Content="Запустить в окне" Click="StartSchedule_Click" IsEnabled="False" /><Button x:Name="StopScheduleButton" Content="Остановить" Margin="8,0,0,0" Click="StopSchedule_Click" IsEnabled="False" /></WrapPanel>
 <TextBlock x:Name="SchedulerStatus" Text="Расписание в окне выключено." TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Expander>
    <Expander Header="Подключение к серверу управления" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock x:Name="AgentIdentity" Margin="0,0,0,8" />
    <ComboBox x:Name="AgentModePicker" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Value" SelectedValuePath="Key"
     SelectionChanged="AgentMode_Changed" Margin="0,0,0,8" />
    <StackPanel x:Name="ServerPanel" Visibility="Collapsed">
     <TextBlock Text="Адрес сервера управления (HTTPS, например https://backup.example.com/)" />
     <TextBox x:Name="ServerAddress" Margin="0,4,0,8" />
     <TextBlock Text="Идентификатор учётных данных агента (без токена или пароля)" />
     <TextBox x:Name="AgentCredentialKey" Margin="0,4,0,8" />
     <TextBlock Text="Интервал связи с сервером, секунд" /><TextBox x:Name="SyncInterval" Text="60" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8" />
    </StackPanel>
    <Button x:Name="SaveAgentSettingsButton" Content="Сохранить режим агента" HorizontalAlignment="Left" Padding="12,6" Click="SaveAgentSettings_Click" IsEnabled="False" />
    <TextBlock Text="Сервер управления ещё разрабатывается. Для локального копирования подключение к нему не требуется."
     TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel></Expander>

   </StackPanel>

    </Border>
   </ScrollViewer>
   <Border Grid.Row="3" Background="{DynamicResource StatusSurfaceBrush}" CornerRadius="6" Padding="8" Margin="0,10,0,0">
    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Status" Text="Загрузка настроек…" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}" /></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
