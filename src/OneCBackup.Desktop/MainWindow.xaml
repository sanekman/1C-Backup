<Window x:Class="OneCBackup.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:OneCBackup.Core;assembly=OneCBackup.Core"
 xmlns:local="clr-namespace:OneCBackup.Desktop"
 PreviewKeyDown="Window_PreviewKeyDown" Title="1C-Backup" Width="1100" Height="740" MinWidth="900" MinHeight="580"
 Icon="Assets/one-c-backup.ico" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}">
 <Window.Resources>
  <local:LocalTimeConverter x:Key="LocalTimeConverter" />
  <local:JobRunOverviewConverter x:Key="JobRunOverviewConverter" />
  <DataTemplate x:Key="DatabaseKindLabel">
   <TextBlock>
    <TextBlock.Style><Style TargetType="TextBlock">
     <Setter Property="Text" Value="{Binding}" />
     <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.OneCFile}"><Setter Property="Text" Value="Файловая 1С" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.SqlServer}"><Setter Property="Text" Value="SQL Server" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.PostgreSql}"><Setter Property="Text" Value="PostgreSQL" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.FilesAndFolders}"><Setter Property="Text" Value="Файлы и папки" /></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="{x:Static core:DatabaseKind.WebDav}"><Setter Property="Text" Value="Файлы WebDAV" /></DataTrigger>
     </Style.Triggers>
    </Style></TextBlock.Style>
   </TextBlock>
  </DataTemplate>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="#CBD5E1" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="Padding" Value="16,12" />
   <Setter Property="Margin" Value="0,0,0,6" />
   <Style.Triggers><Trigger Property="Tag" Value="Active">
    <Setter Property="Background" Value="#334155" /><Setter Property="Foreground" Value="White" />
   </Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="#0F172A" Padding="12,20,12,16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,20">
     <TextBlock Text="1C-Backup" Foreground="White" FontSize="22" FontWeight="Bold" />
     <TextBlock Text="Резервное копирование" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
     <TextBlock x:Name="AppVersion" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,20,8,0">
     <TextBlock Text="Локальное приложение" Foreground="#CBD5E1" FontWeight="SemiBold" />
     <TextBlock Text="Расписание может работать после закрытия окна." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
    </StackPanel>
    <StackPanel>
     <Button x:Name="JobsNavigation" Content="Задания" Tag="Active" Style="{StaticResource NavigationButton}" Click="JobsNavigation_Click" />
     <Button x:Name="CopiesNavigation" Content="Резервные копии" Style="{StaticResource NavigationButton}" Click="CopiesNavigation_Click" />
     <Button x:Name="HistoryNavigation" Content="История запусков" Style="{StaticResource NavigationButton}" Click="HistoryNavigation_Click" />
     <Button x:Name="ExternalMonitoringButton" Content="Мониторинг SQL" Style="{StaticResource NavigationButton}" Click="ExternalMonitoring_Click" IsEnabled="False" ToolTip="Настройка источников и проверка внешних резервных копий SQL" />
     <Button x:Name="AgentNavigation" Content="Настройки" Style="{StaticResource NavigationButton}" Click="AgentNavigation_Click" />
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="18,12,18,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,8">
    <TextBlock x:Name="PageTitle" Text="Задания резервного копирования" FontSize="22" FontWeight="SemiBold" />
    <TextBlock x:Name="PageDescription" Text="Файлы и папки · WebDAV · 1С · SQL Server · PostgreSQL" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
      <Button x:Name="StartBackgroundButton" Content="Включить автоматически" Style="{StaticResource PrimaryButton}" Click="StartBackground_Click" IsEnabled="False" ToolTip="Выполнять сохранённые задания по расписанию даже после закрытия окна" />
      <Button x:Name="StopBackgroundButton" Content="Остановить" Click="StopBackground_Click" IsEnabled="False" Visibility="Collapsed" />
     </StackPanel>
     <StackPanel><TextBlock Text="Автоматическое копирование" FontWeight="SemiBold" /><TextBlock x:Name="BackgroundStatus" Text="Проверка состояния…" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
    </DockPanel>
   </Border>
   <Grid x:Name="JobsView" Grid.Row="2" SizeChanged="JobsView_SizeChanged">
    <Border x:Name="JobListCard" Style="{StaticResource Card}">
     <DockPanel>
      <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" IsMainMenu="False" ToolTip="Перенос настроек задания через файл">
          <MenuItem Header="Файл" Padding="8,6">
           <MenuItem x:Name="ExportJobSettingsMenuItem" Header="Сохранить настройки выбранного задания…" Click="ExportJobSettings_Click" IsEnabled="False" />
           <MenuItem x:Name="ImportJobSettingsMenuItem" Header="Загрузить настройки из файла…" Click="ImportJobSettings_Click" IsEnabled="False" />
          </MenuItem>
         </Menu>
         <Button x:Name="JobScheduleButton" Content="Включить расписание" Click="ToggleJobSchedule_Click" IsEnabled="False" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" />
         <Button x:Name="NewJobButton" Content="+ Новое задание" Style="{StaticResource PrimaryButton}" Click="New_Click" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Мои задания" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="JobsSummary" Text="Загрузка…" Foreground="{DynamicResource MutedBrush}" Margin="12,0,12,0" VerticalAlignment="Center" /></StackPanel>
       </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
       <StackPanel><WrapPanel x:Name="JobActions" Margin="0,0,0,2">
        <Button x:Name="RunButton" Margin="0,0,8,6" Content="Создать копию" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Run_Click" />
        <Button x:Name="EditJobButton" Content="Изменить" Click="EditJob_Click" IsEnabled="False" Margin="0,0,8,6" />
        <Button x:Name="DuplicateJobButton" Content="На основе…" Click="DuplicateJob_Click" IsEnabled="False" Margin="0,0,8,6" ToolTip="Создать новое задание с настройками выбранного. Автоматические запуски новой копии задания отключены до проверки." />
        <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click" IsEnabled="False" Margin="0,0,8,6" />
        <Button x:Name="CancelRunButton" Content="Отменить" Margin="0,0,8,6" IsEnabled="False" Click="CancelRun_Click" />
        <Button x:Name="ShowLatestCopyButton" Content="Последняя копия" Margin="0,0,8,6" IsEnabled="False" Click="ShowLatestCopy_Click" ToolTip="Открыть последнюю сохранённую копию выбранного задания" />
        <Button x:Name="ShowLatestRunButton" Content="Результат" Margin="0,0,8,6" IsEnabled="False" Click="ShowLatestRun_Click" ToolTip="Открыть последний запуск выбранного задания, включая ошибки и предупреждения" />
        <Button x:Name="CheckSourceButton" Content="Проверить источник" Margin="0,0,8,6" IsEnabled="False" Click="CheckSource_Click" ToolTipService.ShowOnDisabled="True" />
        <Button x:Name="CheckStorageButton" Content="Проверить хранилища" Margin="0,0,8,6" IsEnabled="False" Click="CheckStorage_Click" ToolTipService.ShowOnDisabled="True" ToolTip="Проверить временную папку и запись, чтение и удаление тестового файла во всех хранилищах" />
        <Button x:Name="CheckLatestCopiesButton" Content="Проверить последние копии" Margin="0,0,8,6" IsEnabled="False" Click="CheckLatestCopies_Click" ToolTipService.ShowOnDisabled="True" />
        <Button x:Name="CancelStorageCheckButton" Content="Отменить проверку" Margin="0,0,8,6" Visibility="Collapsed" Click="CancelCopyVerification_Click" />
       </WrapPanel>
       <Border x:Name="BackupProgressPanel" Visibility="Collapsed" Padding="8,6" Margin="0,8,0,0" Background="{DynamicResource InfoSurfaceBrush}">
        <StackPanel>
         <TextBlock x:Name="BackupProgressLabel" FontSize="12" TextWrapping="Wrap" />
         <ProgressBar x:Name="BackupProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,4,0,0" AutomationProperties.Name="Выполнение текущего этапа резервного копирования" />
         <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl x:Name="BackupDestinationProgressList">
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6,0,0">
           <TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
           <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Height="4" Margin="0,3,0,0" AutomationProperties.Name="Выполнение доставки в хранилище" />
          </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         </ScrollViewer>
        </StackPanel>
       </Border>
       <ProgressBar x:Name="JobProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Создание резервной копии" />
       <TextBlock x:Name="SelectedJobSummary" Text="Выберите задание, чтобы создать копию или изменить настройки." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" />
       <Expander x:Name="StorageCheckResults" Header="Проверка хранилищ" Visibility="Collapsed" Margin="0,6,0,0">
        <TextBox x:Name="StorageCheckDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6" />
       </Expander>
      </StackPanel></Border>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <DockPanel Margin="12,4"><TextBlock Text="Поиск" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBox x:Name="JobSearch" TextChanged="JobSearch_TextChanged" ToolTip="Поиск по названию задания или источнику" AutomationProperties.Name="Поиск по названию задания или источнику" />
       </DockPanel>
  <DataGrid Grid.Row="1" x:Name="Jobs" RowHeight="30" ColumnHeaderHeight="30" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
   SelectionChanged="Jobs_SelectionChanged" MouseDoubleClick="Jobs_DoubleClick" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="160">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Name}" /></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="Тип" Width="100">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl Content="{Binding Kind}" ContentTemplate="{StaticResource DatabaseKindLabel}" />
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Расписание" Binding="{Binding ScheduleDescription}" Width="145">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding ScheduleDescription}" /></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTemplateColumn Header="Последний запуск" Width="150">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl>
       <ContentControl.Content><MultiBinding Converter="{StaticResource JobRunOverviewConverter}">
        <Binding Path="Id" /><Binding Path="LatestJobRuns" RelativeSource="{RelativeSource AncestorType={x:Type local:MainWindow}}" />
       </MultiBinding></ContentControl.Content>
       <ContentControl.ContentTemplate><DataTemplate>
        <TextBlock Text="{Binding Label}" Foreground="{Binding Color, Converter={StaticResource ThemeColorConverter}}" FontSize="12" TextTrimming="CharacterEllipsis">
         <TextBlock.ToolTip><ToolTip MaxWidth="520"><TextBlock Text="{Binding Help}" TextWrapping="Wrap" /></ToolTip></TextBlock.ToolTip>
        </TextBlock>
       </DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Авто" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBlock ToolTip="Разрешены запуски по расписанию. Для выполнения включите автоматическое копирование.">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Да" /><Style.Triggers>
       <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Text" Value="Нет" /></DataTrigger>
       <DataTrigger Binding="{Binding ScheduleKind}" Value="{x:Static core:ScheduleKind.Manual}"><Setter Property="Text" Value="Нет" /></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>

       <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Margin="0,44,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
         <DataTrigger Binding="{Binding Items.Count, ElementName=Jobs}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
         <TextBlock x:Name="JobsEmptyTitle" Text="Добавьте первое задание" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
         <Button x:Name="FirstJobButton" Content="Создать первое задание" Click="New_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" />
         <TextBlock x:Name="JobsEmptyHint" Text="Укажите базу, хранилище и расписание.&#10;Сохранённое задание появится здесь." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
       </Border>
      </Grid>
     </DockPanel>
    </Border>
    <Border x:Name="EditorCard" Style="{StaticResource Card}" Visibility="Collapsed">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
       <StackPanel><TextBlock x:Name="EditorTitle" Text="Новое задание" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="WizardProgress" Text="1. Источник  →  2. Хранилище  →  3. Расписание  →  4. Проверка" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" />
       </StackPanel>
      </Border>
      <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="JobEditor" Margin="20,16" MaxWidth="700">
        <TextBlock x:Name="WizardHeading" Text="Что будем копировать?" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="WizardHint" Text="Выберите базу и способ создания копии." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16" />
        <StackPanel x:Name="BaseStep">
    <TextBlock x:Name="FileArchiveHint" Visibility="Collapsed" Text="Копируется файл базы в ZIP. Перед запуском закройте эту базу у всех пользователей 1С."
     TextWrapping="Wrap" Margin="0,0,0,12" Background="{DynamicResource WarningSurfaceBrush}" Foreground="{DynamicResource WarningBrush}" Padding="8" />
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Название" /><TextBox x:Name="JobName" Margin="0,4,0,10" /></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Что копировать" /><ComboBox x:Name="Kind" Margin="0,4,0,10" ItemTemplate="{StaticResource DatabaseKindLabel}" SelectionChanged="Kind_Changed" /></StackPanel>
   </Grid>
   <StackPanel x:Name="OneCBasePickerPanel" Margin="0,0,0,8">
    <TextBlock Text="База 1С" />
    <DockPanel Margin="0,4,0,4">
     <Button DockPanel.Dock="Right" Content="Обновить" Click="RefreshOneCBases_Click" Margin="6,0,0,0" Padding="8,5" />
     <ComboBox x:Name="OneCBasePicker" DisplayMemberPath="Name" ToolTip="{Binding SelectedItem.Directory, RelativeSource={RelativeSource Self}}" SelectionChanged="OneCBase_Changed">
      <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="ToolTip" Value="{Binding Directory}" /></Style></ComboBox.ItemContainerStyle>
     </ComboBox>
    </DockPanel>
    <TextBlock x:Name="OneCBaseListStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
   </StackPanel>
   <TextBlock x:Name="SourceLabel" Text="Папка базы 1С" TextWrapping="Wrap" /><DockPanel Margin="0,4,0,10">
    <Button x:Name="SourceFileBrowseButton" DockPanel.Dock="Right" Content="Файл…" Tag="SourceFile" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" Visibility="Collapsed" />
    <Button x:Name="SourceBrowseButton" DockPanel.Dock="Right" Content="Выбрать…" Tag="Source" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <Button DockPanel.Dock="Right" x:Name="WebDavCredentialsButton" Content="Логин и пароль…" Click="WebDavCredentials_Click" Padding="10,5" Margin="6,0,0,0" Visibility="Collapsed" />
    <TextBox x:Name="Source" TextChanged="OneCSource_Changed" />
   </DockPanel>
   <StackPanel x:Name="WebDavPanel" Visibility="Collapsed">
    <TextBlock x:Name="WebDavCredentialStatus" Text="Подключение ещё не настроено" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />

   </StackPanel>
   <StackPanel x:Name="FileBackupPanel" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Способ копирования" />
    <ComboBox x:Name="FileBackupModePicker" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="FileBackupMode_Changed" Margin="0,4,0,8">
     <ComboBoxItem Content="Полная — все файлы" Tag="{x:Static core:FileBackupMode.Full}" />
     <ComboBoxItem Content="Инкрементная — только изменения" Tag="{x:Static core:FileBackupMode.Incremental}" />
    </ComboBox></StackPanel>
    <StackPanel x:Name="FileIncrementalOptions" Grid.Column="1" Width="170" Margin="12,0,0,0" Visibility="Collapsed">
     <TextBlock Text="Архивов в цепочке" />
     <TextBox x:Name="FullBackupEvery" Text="7" Margin="0,4,0,8" ToolTip="Полная основа плюс инкрементные архивы, от 1 до 365. Например, 7: полная и до 6 изменений, затем новая полная." />
    </StackPanel></Grid>
    <TextBlock x:Name="FileSourceConsistencyHint" Text="Перед копированием закройте программы, изменяющие эти файлы." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
    <Expander Header="Как работает копирование" Margin="0,0,0,8">
     <TextBlock Text="Первая инкрементная копия всегда полная. Число архивов включает полную основу; затем начинается новая полная цепочка. Нужные предшествующие архивы сохраняются даже сверх лимита хранилища. Копируются обычные файлы и пустые папки, без единого снимка открытых файлов. Для баз 1С и SQL выбирайте соответствующий тип задания. Ссылки, права доступа и системные атрибуты не переносятся." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
    </Expander>
   </StackPanel>
    <Expander x:Name="WebDavOptionsPanel" Visibility="Collapsed" Header="Адрес подключения и время ожидания" Margin="0,0,0,6"><StackPanel>
     <TextBlock Text="Укажите конечный HTTPS-адрес нужной папки WebDAV, например https://cloud.example/remote.php/dav/files/user/Documents/. Используйте пароль приложения с доступом на чтение. Перенаправления не поддерживаются." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6" />
     <TextBlock Text="Ограничение времени копирования, минут" /><TextBox x:Name="WebDavTimeout" Text="120" Width="100" HorizontalAlignment="Left" Margin="0,4,0,6" />
    </StackPanel></Expander>
   <StackPanel x:Name="OneCMethodPanel">
    <TextBlock Text="Способ резервного копирования 1С" />
    <ComboBox x:Name="OneCMethodPicker" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="OneCMethod_Changed" Margin="0,4,0,10" />
    <StackPanel x:Name="OneCFileAccessPanel" Visibility="Collapsed">
     <CheckBox x:Name="AllowOpenOneCDatabase" Content="Разрешить копирование открытой базы" Checked="OpenOneCDatabase_Changed" Unchecked="OpenOneCDatabase_Changed" Margin="0,0,0,6" />
     <Border x:Name="OpenOneCDatabaseWarning" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
      <TextBlock x:Name="OpenOneCDatabaseWarningText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="12" />
     </Border>
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="OneCPanel">
    <CheckBox x:Name="AutoOneCPlatform" Content="Подбирать установленную платформу автоматически" IsChecked="True" Checked="AutoOneCPlatform_Changed" Unchecked="AutoOneCPlatform_Changed" Margin="0,0,0,6" />
    <StackPanel x:Name="AutoOneCPlatformPanel">
     <TextBlock Text="Версия из свойств базы (пусто — самая новая)" />
     <TextBox x:Name="OneCPlatformVersion" TextChanged="OneCPlatformVersion_Changed" Margin="0,4,0,4" ToolTip="Например, 8.3 — самая новая 8.3; 8.3.25.1540 — точно эта версия." />
    </StackPanel>
    <StackPanel x:Name="ManualOneCPlatformPanel">
    <TextBlock Text="Программа 1С (1cv8.exe)" /><DockPanel Margin="0,4,0,10">
    <Button DockPanel.Dock="Right" Content="…" Tag="OneCExecutable" Click="BrowsePath_Click" Margin="6,0,0,0" Padding="10,6" ToolTip="Выбрать путь" />
    <TextBox x:Name="OneCExecutable" TextChanged="OneCPlatformVersion_Changed" />
   </DockPanel>
    </StackPanel>
    <TextBlock x:Name="OneCPlatformStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
