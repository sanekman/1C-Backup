<Window x:Class="OneCBackup.Desktop.FtpCredentialsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Учётные данные FTP" Width="460" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="20">
  <TextBlock x:Name="BindingName" TextWrapping="Wrap" Margin="0,0,0,12" />
  <TextBlock Text="Логин" /><TextBox x:Name="Username" Margin="0,4,0,12" />
  <TextBlock Text="Пароль (введите при сохранении; прежний пароль не отображается)" TextWrapping="Wrap" />
  <PasswordBox x:Name="Password" Margin="0,4,0,12" />
  <TextBlock Text="Сохраняется в диспетчере учётных данных текущего пользователя Windows. Задания с одинаковым идентификатором используют одну запись."
   TextWrapping="Wrap" Margin="0,0,0,12" />
  <Button x:Name="CredentialSaveButton" Content="Сохранить учётные данные" HorizontalAlignment="Left" Padding="12,6" Click="Save_Click" />
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
 </StackPanel>
</Window>
