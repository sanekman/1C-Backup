@page "/"
@attribute [Authorize(Policy = ServerAuthentication.Administrator)]
@inject ServerStore Store
@inject ServerOptions Settings
@inject IHttpContextAccessor Http
<PageTitle>Агенты — 1C-Backup</PageTitle>
<div class="heading"><div><h1>Агенты</h1><p class="muted">Компьютеры, подключённые к этому серверу.</p></div><a class="button" href="connect">Подключить агент</a></div>
@if (Data is { } data)
{
    <section class="card">
        <div class="summary"><strong>Всего: @data.Total</strong><span>Страница @(data.Page + 1)</span><a href="?page=@data.Page">Обновить</a></div>
        @if (data.Total == 0)
        {
            <div class="empty"><h2>Подключите первый компьютер</h2><p>Создайте одноразовое приглашение. После подключения здесь появятся версия агента и время последней связи.</p><a href="connect">Создать приглашение</a></div>
        }
        else
        {
            <div class="table-scroll"><table><thead><tr><th>Компьютер</th><th>Связь</th><th>Последняя связь</th><th>Настройки</th></tr></thead><tbody>
            @foreach (var agent in data.Agents)
            {
                <tr><td><a href="@("agents/" + agent.AgentId)">@agent.Name</a><small>@(agent.AgentVersion ?? "Версия ещё не получена")</small></td>
                    <td><span class="badge @(agent.Revoked ? "bad" : Online(agent) ? "good" : "pending")">@State(agent)</span></td>
                    <td>@Time(agent.ReceivedUtc)</td>
                    <td><small>На сервере: @agent.DesiredRevision</small><small>Сообщено агентом: @(agent.ReportedRevision?.ToString() ?? "—")</small></td></tr>
            }
            </tbody></table></div>
            <div class="pagination">@if (data.Page > 0) { <a href="?page=@(data.Page - 1)">← Назад</a> } @if ((data.Page + 1) * data.PageSize < data.Total) { <a href="?page=@(data.Page + 1)">Далее →</a> }</div>
        }
    </section>
    <p class="muted note">«На связи» означает недавний ответ агента. Успех копирования определяется отдельным отчётом о запуске. Подтверждения настройки и результаты копий будут добавлены следующим этапом.</p>
}
@code {
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; }
    private AgentPage? Data;
    protected override async Task OnParametersSetAsync() => Data = await Store.AgentsAsync(Page, Http.HttpContext!.RequestAborted);
    private bool Online(AgentRecord agent) => agent.ReceivedUtc is { } time && DateTimeOffset.UtcNow - time < TimeSpan.FromSeconds(Settings.OfflineAfterSeconds);
    private string State(AgentRecord agent) => agent.Revoked ? "Доступ отозван" : agent.ReceivedUtc is null ? "Ожидает первого сигнала" : Online(agent) ? "На связи" : "Нет связи";
    internal static string Time(DateTimeOffset? value) => value?.UtcDateTime.ToString("dd.MM.yyyy HH:mm:ss", CultureInfo.InvariantCulture) ?? "Ещё не получена";
}
