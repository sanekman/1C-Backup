@page "/login"
@attribute [AllowAnonymous]
<PageTitle>Вход — 1C-Backup</PageTitle>
<section class="card login">
    <h1>Вход на сервер</h1>
    <p class="muted">Войдите под учётной записью администратора сервера.</p>
    @if (Failed == "1") { <p class="error" role="alert">Не удалось войти. Проверьте имя и пароль.</p> }
    <form action="session/login" method="post">
        <AntiforgeryToken />
        <label>Имя пользователя<input name="name" autocomplete="username" maxlength="80" required /></label>
        <label>Пароль<input name="password" type="password" autocomplete="current-password" maxlength="256" required /></label>
        <button type="submit">Войти</button>
    </form>
</section>
@code { [SupplyParameterFromQuery(Name = "failed")] public string? Failed { get; set; } }
