# No passwords belong in this example. Supply real values through protected files.
ASPNETCORE_URLS=https://0.0.0.0:7443
AllowedHosts=backup.example.com
Server__DataDirectory=/var/lib/onec-backup-server
Server__ConnectionStringFile=/etc/onec-backup-server/connection-string.txt
Server__HttpsCertificatePath=/etc/onec-backup-server/server.pfx
Server__HttpsCertificatePasswordFile=/etc/onec-backup-server/certificate-password.txt
# Required only for the one-time --initialize command:
Server__BootstrapUser=admin
Server__BootstrapPasswordFile=/etc/onec-backup-server/administrator-password.txt
