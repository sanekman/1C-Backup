<?xml version="1.0" encoding="utf-8"?>
<!-- IIS WebSocket Protocol + URL Rewrite + ARR are required. ARR proxy must be enabled server-wide. -->
<configuration>
 <system.webServer>
  <webSocket enabled="true" />
  <rewrite><rules><rule name="OneCBackupHub" stopProcessing="true">
   <match url="(.*)" />
   <action type="Rewrite" url="http://127.0.0.1:7087/{R:1}" />
  </rule></rules></rewrite>
 </system.webServer>
</configuration>
